---
import SiteIcon from "../shared/SiteIcon.astro";
---

<section class="container py-5 attention-spirals-section">
  <div class="attention-spirals-panel mx-auto">
    <div class="text-center attention-spirals-heading mx-auto">
      <span class="feature-kicker">ATTENTION SPIRALS</span>
      <h2>
        Built for people who keep saying:<br />
        <span>&ldquo;just one minute&rdquo;</span>
      </h2>
      <p class="hero-muted-override mb-0">
        CogniFocus is available now for Android users who start with a quick
        check and end up losing the whole session. iOS is coming next.
      </p>
    </div>

    <div class="attention-spirals-grid">
      <article class="attention-spiral-card attention-spiral-card--quick">
        <div class="attention-spiral-visual" aria-hidden="true">
          <span class="spiral-progress-ring"></span>
          <span class="spiral-icon spiral-icon-instagram">
            <SiteIcon name="simple-icons:instagram" aria-hidden="true" />
          </span>
          <span class="spiral-chip spiral-chip-time">27m later</span>
        </div>
        <h3>The quick checker</h3>
        <p>
          &ldquo;I opened Instagram for 10 seconds and somehow came back
          27 minutes later.&rdquo;
        </p>
      </article>

      <article
        class="attention-spiral-card attention-spiral-card--switch"
      >
        <div class="attention-spiral-visual" aria-hidden="true">
          <span class="spiral-motion-trail"></span>
          <span class="spiral-icon spiral-icon-focus">
            <SiteIcon name="mdi:bullseye" aria-hidden="true" />
          </span>
          <span class="spiral-icon spiral-icon-tiktok">
            <SiteIcon name="simple-icons:tiktok" aria-hidden="true" />
          </span>
          <span class="spiral-chip spiral-chip-switch">app switch</span>
        </div>
        <h3>The app switcher</h3>
        <p>
          &ldquo;I switch from work to TikTok before the timer even
          settles.&rdquo;
        </p>
      </article>

      <article class="attention-spiral-card attention-spiral-card--timer">
        <div class="attention-spiral-visual" aria-hidden="true">
          <span
            class="spiral-progress-ring spiral-progress-ring-muted"
          ></span>
          <span class="spiral-chip spiral-chip-timer">18:42</span>
          <span class="spiral-chip spiral-chip-session"
            >session active</span
          >
        </div>
        <h3>The timer ignorer</h3>
        <p>
          &ldquo;I start focus sessions&hellip; then leave them running in
          the background.&rdquo;
        </p>
      </article>

      <article
        class="attention-spiral-card attention-spiral-card--memory"
      >
        <div class="attention-spiral-visual" aria-hidden="true">
          <span class="spiral-autopilot-ring"></span>
          <span class="spiral-icon spiral-icon-orbit spiral-orbit-one">
            <SiteIcon name="simple-icons:instagram" aria-hidden="true" />
          </span>
          <span class="spiral-icon spiral-icon-orbit spiral-orbit-two">
            <SiteIcon name="simple-icons:youtube" aria-hidden="true" />
          </span>
          <span class="spiral-icon spiral-icon-orbit spiral-orbit-three">
            <SiteIcon name="simple-icons:tiktok" aria-hidden="true" />
          </span>
        </div>
        <h3>The muscle-memory scroller</h3>
        <p>
          &ldquo;My thumb opens social apps before my brain approves
          it.&rdquo;
        </p>
      </article>
    </div>
  </div>
</section>

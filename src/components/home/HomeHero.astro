---
import { Picture } from "astro:assets";
import heroGoblinCheerful from "../../assets/characters/goblin/face/cheerful.png";
---

<section class="container py-4 py-md-5 hero-section">
  <div class="hero-layout">
    <div class="hero-left">
      <div class="hero-copy">
        <p class="seo-eyebrow">Focus Timer &amp; App Blocker</p>
        <h1 class="display-5 fw-bold hero-heading">
          <span class="hero-heading-line">"Just one scroll"</span>
          <span class="hero-heading-line hero-heading-accent"
            >Becomes an hour fast</span
          >
        </h1>
        <p class="text-muted hero-muted-override">
          CogniFocus is a free focus timer and app blocker for TikTok,
          Instagram, YouTube, and distracting apps, helping you recover
          fast and build focus streaks.
        </p>
      </div>

      <div class="hero-actions">
        <div class="hero-cta">
          <a
            href="https://play.google.com/store/apps/details?id=io.ionic.cognifocus"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-glow btn-lg me-1 primary-cta"
            data-keep-label="true"
            ><span class="cta-playstore-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" role="img" focusable="false">
                <path
                  fill="#00d26a"
                  d="M3.3 2.5L14.7 14 3.3 21.5c-.4-.2-.6-.6-.6-1V4c0-.4.2-.8.6-1z"
                />
                <path
                  fill="#00a0ff"
                  d="M18.4 11.5l-3.7-2.1L10.9 12l3.8 2.6 3.7-2.1c.8-.4.8-1.4 0-1.9z"
                />
                <path
                  fill="#ffe000"
                  d="M3.3 2.5l11.4 11.5 3.7-2.1L6.8 5.3 3.3 2.5z"
                />
                <path
                  fill="#ff4f5e"
                  d="M3.3 21.5l3.5-2.8 11.6-6.8-3.7-2.1L3.3 21.5z"
                />
              </svg>
            </span>
            <span class="cta-label">Start Free on Android</span>
          </a>
          <a
            href="/ios-waitlist.html"
            class="btn hero-ios-waitlist d-none d-md-inline-flex"
          >
            <i class="bi bi-apple" aria-hidden="true"></i>
            <span>iOS Waitlist</span>
          </a>
        </div>
      </div>
    </div>
    <figure
      class="hero-media"
      aria-label="CogniFocus attention vacuum animation"
    >
      <div class="hero-media-card attention-vacuum-demo">
        <div class="vacuum-orbit" aria-hidden="true">
          <span class="vacuum-particle vacuum-particle-one"></span>
          <span class="vacuum-particle vacuum-particle-two"></span>
          <span class="vacuum-particle vacuum-particle-three"></span>
          <div class="vacuum-core">
            <span class="vacuum-core-ring"></span>
            <span class="vacuum-core-pulse"></span>
          </div>

          <span class="vacuum-app-icon vacuum-app-ig">
            <i class="bi bi-instagram" aria-hidden="true"></i>
            <span class="vacuum-cross"></span>
          </span>
          <span class="vacuum-app-icon vacuum-app-tiktok">
            <i class="bi bi-tiktok" aria-hidden="true"></i>
            <span class="vacuum-cross"></span>
          </span>
          <span class="vacuum-app-icon vacuum-app-x">
            <i class="bi bi-twitter-x" aria-hidden="true"></i>
            <span class="vacuum-cross"></span>
          </span>
          <span class="vacuum-app-icon vacuum-app-yt">
            <i class="bi bi-youtube" aria-hidden="true"></i>
            <span class="vacuum-cross"></span>
          </span>
          <span class="vacuum-app-icon vacuum-app-reddit">
            <i class="bi bi-reddit" aria-hidden="true"></i>
            <span class="vacuum-cross"></span>
          </span>
          <span class="vacuum-app-icon vacuum-app-facebook">
            <i class="bi bi-facebook" aria-hidden="true"></i>
            <span class="vacuum-cross"></span>
          </span>

          <div class="vacuum-goblin-success">
            <Picture
              src={heroGoblinCheerful}
              formats={["avif", "webp"]}
              fallbackFormat="png"
              alt=""
              loading="eager"
              decoding="async"
              fetchpriority="high"
              fit="contain"
              width="240"
              height="240"
            />
            <span>Focus saved</span>
          </div>
        </div>
      </div>
    </figure>
  </div>
</section>

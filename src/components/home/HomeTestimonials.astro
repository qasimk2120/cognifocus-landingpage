---
import annoyedGoblinFace from "../../assets/characters/goblin/face/annoyed.png";
import angryGoblinFace from "../../assets/characters/goblin/face/angry.png";
import cheerfulGoblinFace from "../../assets/characters/goblin/face/cheerful.png";
import neutralGoblinAvatar from "../../assets/characters/goblin/avatar/neutral.png";
import ReactionTestimonialCard from "./ReactionTestimonialCard.astro";
import SiteIcon from "../shared/SiteIcon.astro";

const reactionCards = [
  {
    moodClass: "reaction-slide--neutral",
    quote:
      '"The neutral look is almost worse than a notification. It feels like the app noticed I was about to drift before I did."',
    attribution: "Beta Tester",
    image: neutralGoblinAvatar,
    alt: "CogniFocus Neutral Goblin watching a focus session",
    isActive: true,
  },
  {
    moodClass: "reaction-slide--annoyed",
    quote:
      '"I opened TikTok out of habit and the annoyed Goblin snapped me out of autopilot faster than any timer I have used."',
    attribution: "Study Session User",
    image: annoyedGoblinFace,
    alt: "CogniFocus Annoyed Goblin reacting to a distraction attempt",
  },
  {
    moodClass: "reaction-slide--cheerful",
    quote:
      '"Went from 8 Instagram breaks per study session to maybe 1. The Goblin celebrating the clean session made me want to keep the streak alive."',
    attribution: "Early Access User",
    image: cheerfulGoblinFace,
    alt: "CogniFocus Cheerful Goblin reacting to a clean focus session",
  },
  {
    moodClass: "reaction-slide--angry",
    quote:
      '"The angry reaction is ridiculous in the best way. It turns one more scroll into a tiny moment of accountability."',
    attribution: "Focus Sprint User",
    image: angryGoblinFace,
    alt: "CogniFocus Angry Goblin warning about a distraction",
  },
];
---

<section class="container py-5 testimonials-strip">
  <div class="reaction-carousel" data-reaction-carousel>
    <div class="reaction-carousel-heading">
      <span class="testimonial-pill" role="note"
        >What people are saying</span
      >
      <h2>
        The Goblin reactions got
        <span class="hero-heading-line hero-heading-accent">
          weirdly effective</span
        >
      </h2>
    </div>

    <p class="hero-muted-override mb-3 visually-hidden">
      Early access users reported going from multiple Instagram breaks
      per session to one or fewer &#124; with the Goblin streak system cited
      as the primary motivation to maintain clean sessions.
    </p>

    <div class="reaction-carousel-viewport" aria-live="polite">
      <div class="reaction-carousel-track" data-reaction-track>
        {
          reactionCards.map((card) => (
            <ReactionTestimonialCard {...card} />
          ))
        }
        <!-- Press mention slide -->
        <article class="reaction-slide reaction-slide--press" data-reaction-slide>
          <div class="reaction-slide-copy">
            <span class="reaction-press-label">As seen in</span>
            <p class="testimonial-quote">
              "CogniFocus Catches You Mid-Scroll During a Focus Session — That Is the Entire Point"
            </p>
            <span class="testimonial-name">Startup Fortune</span>
            <a
              href="https://startupfortune.com/qasim-built-cognifocus-because-most-focus-apps-keep-counting-while-your-brain-is-already-on-tiktok/"
              target="_blank"
              rel="noopener noreferrer"
              class="reaction-press-link"
            >Read the story →</a>
          </div>
          <span class="reaction-slide-separator" aria-hidden="true"></span>
          <div class="reaction-press-icon" aria-hidden="true">
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"/><path d="M18 14h-8"/><path d="M15 18h-5"/><path d="M10 6h8v4h-8z"/></svg>
          </div>
        </article>
      </div>
    </div>

    <div class="reaction-carousel-progress" aria-label="Reaction slides">
      <button
        type="button"
        class="reaction-carousel-arrow reaction-carousel-arrow--prev"
        aria-label="Show previous reaction"
        data-reaction-prev
      >
        <SiteIcon name="mdi:chevron-left" aria-hidden="true" />
      </button>
      <button
        type="button"
        class="reaction-progress-dot is-active"
        aria-label="Show reaction page 1"
        data-reaction-dot="0"
      ></button>
      <button
        type="button"
        class="reaction-progress-dot"
        aria-label="Show reaction page 2"
        data-reaction-dot="1"
      ></button>
      <button
        type="button"
        class="reaction-progress-dot"
        aria-label="Show reaction page 3"
        data-reaction-dot="2"
      ></button>
      <button
        type="button"
        class="reaction-progress-dot"
        aria-label="Show reaction page 4"
        data-reaction-dot="3"
      ></button>
      <button
        type="button"
        class="reaction-progress-dot"
        aria-label="Show reaction page 5"
        data-reaction-dot="4"
      ></button>
      <button
        type="button"
        class="reaction-carousel-arrow reaction-carousel-arrow--next"
        aria-label="Show next reaction"
        data-reaction-next
      >
        <SiteIcon name="mdi:chevron-right" aria-hidden="true" />
      </button>
    </div>
  </div>
</section>

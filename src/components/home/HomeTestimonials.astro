---
import { Picture } from "astro:assets";
import cheerfulGoblinFace from "../../assets/characters/goblin/face/cheerful.png";
import annoyedGoblinFace from "../../assets/characters/goblin/face/annoyed.png";
import angryGoblinFace from "../../assets/characters/goblin/face/angry.png";
import neutralGoblinAvatar from "../../assets/characters/goblin/avatar/neutral.png";
import SiteIcon from "../shared/SiteIcon.astro";
---

<section class="container py-5 testimonials-strip">
  <div class="reaction-carousel" data-reaction-carousel>
    <div class="reaction-carousel-heading">
      <span class="testimonial-pill" role="note"
        >What people are saying</span
      >
      <h2>
        The Goblin reactions got
        <span class="hero-heading-line hero-heading-accent">
          weirdly effective</span
        >
      </h2>
    </div>

    <p class="hero-muted-override mb-3 visually-hidden">
      Early access users reported going from multiple Instagram breaks
      per session to one or fewer — with the Goblin streak system cited
      as the primary motivation to maintain clean sessions.
    </p>

    <div class="reaction-carousel-card" aria-live="polite">
      <article class="reaction-slide is-active" data-reaction-slide>
        <div class="reaction-slide-copy">
          <p class="testimonial-quote">
            "Went from 8 Instagram breaks per study session to maybe 1.
            The Goblin celebrating the clean session made me want to keep
            the streak alive."
          </p>
          <span class="testimonial-name">Early Access User</span>
        </div>
        <Picture
          class="reaction-goblin-face"
          src={cheerfulGoblinFace}
          formats={["avif", "webp"]}
          fallbackFormat="png"
          alt="CogniFocus Cheerful Goblin reacting to a clean focus session"
          width="244"
          height="191"
          layout="constrained"
          loading="lazy"
          decoding="async"
        />
      </article>

      <article class="reaction-slide" data-reaction-slide>
        <div class="reaction-slide-copy">
          <p class="testimonial-quote">
            "The neutral look is almost worse than a notification. It
            feels like the app noticed I was about to drift before I did."
          </p>
          <span class="testimonial-name">Beta Tester</span>
        </div>
        <Picture
          class="reaction-goblin-face"
          src={neutralGoblinAvatar}
          formats={["avif", "webp"]}
          fallbackFormat="png"
          alt="CogniFocus Neutral Goblin watching a focus session"
          width="244"
          height="191"
          layout="constrained"
          loading="lazy"
          decoding="async"
        />
      </article>

      <article class="reaction-slide" data-reaction-slide>
        <div class="reaction-slide-copy">
          <p class="testimonial-quote">
            "I opened TikTok out of habit and the annoyed Goblin snapped
            me out of autopilot faster than any timer I have used."
          </p>
          <span class="testimonial-name">Study Session User</span>
        </div>
        <Picture
          class="reaction-goblin-face"
          src={annoyedGoblinFace}
          formats={["avif", "webp"]}
          fallbackFormat="png"
          alt="CogniFocus Annoyed Goblin reacting to a distraction attempt"
          width="244"
          height="191"
          layout="constrained"
          loading="lazy"
          decoding="async"
        />
      </article>

      <article class="reaction-slide" data-reaction-slide>
        <div class="reaction-slide-copy">
          <p class="testimonial-quote">
            "The angry reaction is ridiculous in the best way. It turns
            one more scroll into a tiny moment of accountability."
          </p>
          <span class="testimonial-name">Focus Sprint User</span>
        </div>
        <Picture
          class="reaction-goblin-face"
          src={angryGoblinFace}
          formats={["avif", "webp"]}
          fallbackFormat="png"
          alt="CogniFocus Angry Goblin warning about a distraction"
          width="244"
          height="191"
          layout="constrained"
          loading="lazy"
          decoding="async"
        />
      </article>
    </div>

    <div class="reaction-carousel-progress" aria-label="Reaction slides">
      <button
        type="button"
        class="reaction-carousel-arrow reaction-carousel-arrow--prev"
        aria-label="Show previous reaction"
        data-reaction-prev
      >
        <SiteIcon name="mdi:chevron-left" aria-hidden="true" />
      </button>
      <button
        type="button"
        class="reaction-progress-dot is-active"
        aria-label="Show reaction 1"
        data-reaction-dot="0"
      ></button>
      <button
        type="button"
        class="reaction-progress-dot"
        aria-label="Show reaction 2"
        data-reaction-dot="1"
      ></button>
      <button
        type="button"
        class="reaction-progress-dot"
        aria-label="Show reaction 3"
        data-reaction-dot="2"
      ></button>
      <button
        type="button"
        class="reaction-progress-dot"
        aria-label="Show reaction 4"
        data-reaction-dot="3"
      ></button>
      <button
        type="button"
        class="reaction-carousel-arrow reaction-carousel-arrow--next"
        aria-label="Show next reaction"
        data-reaction-next
      >
        <SiteIcon name="mdi:chevron-right" aria-hidden="true" />
      </button>
    </div>
  </div>
</section>

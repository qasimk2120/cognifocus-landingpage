---
import DemoVideo from "../shared/DemoVideo.astro";
---

<section
  id="demo"
  class="container py-5 home-demo-section"
  aria-labelledby="homeDemoTitle"
>
  <div class="home-demo-showcase">
    <p class="home-demo-pill">APP DEMO</p>
    <h2 id="homeDemoTitle" class="home-demo-heading">
      See CogniFocus fight
      <span class="hero-heading-line hero-heading-accent">
        distractions in 34 seconds</span
      >
    </h2>
    <DemoVideo previewMode={true} />
  </div>
</section>

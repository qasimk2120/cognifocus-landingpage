---
import { Image } from "astro:assets";
import textLogoTight from "../../assets/logo/text-logo-tight.png";
---

<section id="early" class="container py-5 text-center final-focus-section">
  <div class="final-focus-panel mx-auto">
    <span
      class="final-focus-orbit final-focus-orbit-one"
      aria-hidden="true"
    ></span>
    <span
      class="final-focus-orbit final-focus-orbit-two"
      aria-hidden="true"
    ></span>

    <div class="final-focus-logo-wrap" aria-hidden="true">
      <Image
        src={textLogoTight}
        alt="CogniFocus"
        title="CogniFocus"
        width="415"
        height="125"
        loading="lazy"
        decoding="async"
      />
    </div>

    <blockquote class="final-founder-quote">
      I built CogniFocus because &ldquo;just one quick check&rdquo;<br />
      <span class="hero-heading-line hero-heading-accent"
        >kept turning into lost hours</span
      >
    </blockquote>

    <div class="final-focus-cta">
      <p>Your next session doesn&rsquo;t have to end in a scroll hole.</p>

      <div class="hero-cta">
        <a
          href="https://play.google.com/store/apps/details?id=io.ionic.cognifocus"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-glow btn-lg me-1 primary-cta"
          data-keep-label="true"
          ><span class="cta-playstore-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" role="img" focusable="false">
              <path
                fill="#00d26a"
                d="M3.3 2.5L14.7 14 3.3 21.5c-.4-.2-.6-.6-.6-1V4c0-.4.2-.8.6-1z"
              />
              <path
                fill="#00a0ff"
                d="M18.4 11.5l-3.7-2.1L10.9 12l3.8 2.6 3.7-2.1c.8-.4.8-1.4 0-1.9z"
              />
              <path
                fill="#ffe000"
                d="M3.3 2.5l11.4 11.5 3.7-2.1L6.8 5.3 3.3 2.5z"
              />
              <path
                fill="#ff4f5e"
                d="M3.3 21.5l3.5-2.8 11.6-6.8-3.7-2.1L3.3 21.5z"
              />
            </svg>
          </span>
          <span class="cta-label">Start Free on Android</span>
        </a>
      </div>

      <p class="final-focus-note">
        Available now on Android. iOS waitlist available.
      </p>
    </div>
  </div>
</section>

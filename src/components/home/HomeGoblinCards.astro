---
import { Picture } from "astro:assets";
import SiteIcon from "../shared/SiteIcon.astro";
import angryGoblinAvatar from "../../assets/characters/goblin/avatar/angry.png";
import annoyedGoblinAvatar from "../../assets/characters/goblin/avatar/annoyed.png";
import cheerfulGoblinAvatar from "../../assets/characters/goblin/avatar/cheerful.png";

const tapHintLabels = {
  shieldInterruption: "tap -> see how Shield blocks it",
  recoverySystem: "tap -> see the recovery system",
  progressRewards: "tap -> see what you earn",
  shieldRoadmap: "tap -> see what's coming",
};
---

<section id="why" class="container py-5">
  <div class="why-panel mx-auto">
    <div class="text-center why-heading mx-auto">
      <span class="feature-kicker">BEHAVIOR REACTIONS</span>
      <h2 class="mb-3">
        Every distraction gets
        <span class="hero-heading-line hero-heading-accent">
          a reaction</span
        >
      </h2>
      <p class="hero-muted-override mb-0">
        Tap a Goblin moment to see what system kicks in.
      </p>
      <div
        class="reaction-utility-chips"
        aria-label="CogniFocus utility highlights"
      >
        <span class="reaction-utility-chip">Blocks apps</span>
        <span class="reaction-utility-chip">Protects sessions</span>
        <span class="reaction-utility-chip">Nudges recovery</span>
        <span class="reaction-utility-chip">Tracks progress</span>
      </div>
    </div>

    <div class="goblin-cards-grid">
      <!-- Card 1: Angry -->
      <button class="goblin-card" type="button" aria-expanded="false">
        <div class="goblin-card-inner">
          <div class="goblin-card-front">
            <div class="goblin-card-app-icons" aria-hidden="true">
              <span class="goblin-card-app-icon app-icon-instagram">
                <SiteIcon name="simple-icons:instagram" aria-hidden="true" />
              </span>
              <span class="goblin-card-app-icon app-icon-tiktok">
                <SiteIcon name="simple-icons:tiktok" aria-hidden="true" />
              </span>
              <span class="goblin-card-app-icon app-icon-youtube">
                <SiteIcon name="simple-icons:youtube" aria-hidden="true" />
              </span>
              <span class="goblin-card-app-icon app-icon-x">
                <SiteIcon name="simple-icons:x" aria-hidden="true" />
              </span>
            </div>
            <div class="goblin-alert-system" aria-hidden="true">
              <span class="goblin-alert-pulse"></span>
              <span class="goblin-app-trail trail-one"></span>
              <span class="goblin-app-trail trail-two"></span>
            </div>
            <Picture
              src={angryGoblinAvatar}
              formats={["avif", "webp"]}
              fallbackFormat="png"
              alt="CogniFocus Goblin angry reaction to a distraction attempt on Android"
              title="CogniFocus Goblin angry reaction to a distraction attempt on Android"
              class="goblin-avatar"
              loading="lazy"
              decoding="async"
              width="419"
              height="470"
              layout="constrained"
            />
            <p class="goblin-moment">opened TikTok again?</p>
            <span class="tap-hint">{tapHintLabels.shieldInterruption}</span>
          </div>
          <div class="goblin-card-back">
            <h3>Shield interrupts distractions</h3>
            <p>
              CogniFocus blocks selected apps during focus sessions before
              one quick check becomes a lost hour.
            </p>
            <span class="goblin-tag">Live interruption</span>
          </div>
        </div>
      </button>

      <!-- Card 2: Annoyed -->
      <button class="goblin-card" type="button" aria-expanded="false">
        <div class="goblin-card-inner">
          <div class="goblin-card-front">
            <div class="goblin-notification-icons" aria-hidden="true">
              <span class="goblin-notification-icon notification-bell">
                <SiteIcon name="mdi:bell" aria-hidden="true" />
              </span>
              <span class="goblin-notification-icon notification-chat">
                <SiteIcon name="mdi:chat" aria-hidden="true" />
              </span>
            </div>
            <div class="goblin-recovery-system" aria-hidden="true">
              <span class="recovery-timer-ring">
                <span
                  class="recovery-clock-hand recovery-clock-hour"
                ></span>
                <span
                  class="recovery-clock-hand recovery-clock-minute"
                ></span>
              </span>
              <span class="recovery-session-chip">
                <span><SiteIcon name="mdi:play" aria-hidden="true" /> running</span>
                <span><SiteIcon name="mdi:pause" aria-hidden="true" /> paused</span>
                <span><SiteIcon name="mdi:check" aria-hidden="true" /> completed</span>
              </span>
            </div>
            <Picture
              src={annoyedGoblinAvatar}
              formats={["avif", "webp"]}
              fallbackFormat="png"
              alt="CogniFocus Goblin annoyed reaction when focus session is abandoned"
              title="CogniFocus Goblin annoyed reaction when focus session is abandoned"
              class="goblin-avatar"
              loading="lazy"
              decoding="async"
              width="500"
              height="500"
              layout="constrained"
            />
            <p class="goblin-moment">bro left the session</p>
            <span class="tap-hint">{tapHintLabels.recoverySystem}</span>
          </div>
          <div class="goblin-card-back">
            <h3>Recovery nudges pull you back</h3>
            <p>
              Slip once, recover fast, and keep the session alive instead
              of treating one distraction like failure.
            </p>
            <span class="goblin-tag">Recovery system</span>
          </div>
        </div>
      </button>

      <!-- Card 3: Cheerful -->
      <button class="goblin-card" type="button" aria-expanded="false">
        <div class="goblin-card-inner">
          <div class="goblin-card-front">
            <div class="goblin-progress-icons" aria-hidden="true">
              <span class="progress-graph-line">
                <SiteIcon name="mdi:trending-up" aria-hidden="true" />
              </span>
              <span class="progress-xp-chip">+XP</span>
              <span class="progress-diamond-chip">
                <SiteIcon name="mdi:diamond-stone" aria-hidden="true" />
                <span>+1</span>
              </span>
            </div>
            <div class="goblin-success-system" aria-hidden="true">
              <span class="success-spark spark-one"></span>
              <span class="success-spark spark-two"></span>
              <span class="success-spark spark-three"></span>
            </div>
            <Picture
              src={cheerfulGoblinAvatar}
              formats={["avif", "webp"]}
              fallbackFormat="png"
              alt="CogniFocus Goblin cheerful reaction after a clean focus session"
              title="CogniFocus Goblin cheerful reaction after a clean focus session"
              class="goblin-avatar"
              loading="lazy"
              decoding="async"
              width="422"
              height="466"
              layout="constrained"
            />
            <p class="goblin-moment">
              wait... you actually stayed focused?
            </p>
            <span class="tap-hint">{tapHintLabels.progressRewards}</span>
          </div>
          <div class="goblin-card-back">
            <h3>Clean focus turns into progress</h3>
            <p>
              Focus sessions build streaks, XP, diamonds, and companion
              affinity over time.
            </p>
            <span class="goblin-tag">Progression loop</span>
          </div>
        </div>
      </button>

      <!-- Card 4: Neutral -->
      <button class="goblin-card" type="button" aria-expanded="false">
        <div class="goblin-card-inner">
          <div class="goblin-card-front">
            <div class="goblin-shield-feature-icons" aria-hidden="true">
              <span class="goblin-shield-feature shield-feature-ghost">
                <SiteIcon name="mdi:incognito" aria-hidden="true" />
              </span>
              <span class="goblin-shield-feature shield-feature-dnd">
                <SiteIcon name="mdi:minus-circle-outline" aria-hidden="true" />
              </span>
              <span
                class="goblin-shield-feature shield-feature-notifications"
              >
                <SiteIcon name="mdi:bell-off" aria-hidden="true" />
              </span>
            </div>
            <div class="goblin-shield-avatar" aria-hidden="true">
              <SiteIcon name="mdi:shield-lock" aria-hidden="true" />
            </div>
            <p class="goblin-moment">trying to escape later?</p>
            <span class="tap-hint">{tapHintLabels.shieldRoadmap}</span>
          </div>
          <div class="goblin-card-back">
            <h3>Stronger protection is coming</h3>
            <p>
              Upcoming Shield upgrades include uninstall protection, Ghost
              Mode, DND support, and stricter focus modes.
            </p>
            <span class="goblin-tag">Shield roadmap</span>
          </div>
        </div>
      </button>

      <!-- Card 5: Companions -->
      <button class="goblin-card" type="button" aria-expanded="false">
        <div class="goblin-card-inner">
          <div class="goblin-card-front">
            <div class="goblin-shield-feature-icons" aria-hidden="true">
              <span class="goblin-shield-feature shield-feature-ghost">
                <SiteIcon name="mdi:account-multiple" aria-hidden="true" />
              </span>
              <span class="goblin-shield-feature shield-feature-dnd">
                <SiteIcon name="mdi:account" aria-hidden="true" />
              </span>
              <span
                class="goblin-shield-feature shield-feature-notifications"
              >
                <SiteIcon name="mdi:account-heart" aria-hidden="true" />
              </span>
            </div>
            <div class="goblin-shield-avatar" aria-hidden="true">
              <SiteIcon name="mdi:account-group" aria-hidden="true" />
            </div>
            <p class="goblin-moment">more company, same mess</p>
            <span class="tap-hint">tap &rarr; see what's next</span>
          </div>
          <div class="goblin-card-back">
            <h3>More companions. Different chaos.</h3>
            <p>
              Monk, Buddy, Wizard and others are in the works. Goblin's not
              the only one watching.
            </p>
            <span class="goblin-tag">Companion roadmap</span>
          </div>
        </div>
      </button>
    </div>
  </div>
</section>

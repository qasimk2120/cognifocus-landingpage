<aside
  class="cf-cookie-consent"
  id="cf-cookie-consent"
  aria-labelledby="cf-cookie-consent-title"
  aria-describedby="cf-cookie-consent-body"
  hidden
>
  <div class="cf-cookie-consent__copy">
    <h2 id="cf-cookie-consent-title">Tiny analytics goblin?</h2>
    <p id="cf-cookie-consent-body">
    We use lightweight analytics to understand what helps people focus. No creepy stuff.
    </p>
    <span class="cf-cookie-consent__links">
      <a class="cf-cookie-consent__link" href="/privacy.html">Privacy</a>
      <span aria-hidden="true">&middot;</span>
      <a class="cf-cookie-consent__link" href="/terms.html">Terms</a>
    </span>
  </div>
  <div class="cf-cookie-consent__actions">
    <button
      class="cf-cookie-consent__button cf-cookie-consent__button--primary"
      type="button"
      data-cookie-consent-accept
      aria-label="Allow analytics"
    >
      Allow analytics
    </button>
    <button
      class="cf-cookie-consent__button cf-cookie-consent__button--secondary"
      type="button"
      data-cookie-consent-decline
      aria-label="Decline analytics"
    >
      Decline
    </button>
  </div>
</aside>

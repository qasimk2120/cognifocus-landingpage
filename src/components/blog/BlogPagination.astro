---
import SiteIcon from "../shared/SiteIcon.astro";
import { BLOG_PAGE_SIZE, BLOG_PAGE_SIZE_OPTIONS, normalizeBlogPageSize } from "../../utils/blog";

const {
  page,
  basePath,
  pageSize = BLOG_PAGE_SIZE,
  pageSizeOptions = BLOG_PAGE_SIZE_OPTIONS,
} = Astro.props;

const currentPageSize = normalizeBlogPageSize(pageSize);
const defaultBasePath = (basePath || "/blog").replace(/\/per-page\/\d+$/, "");

const normalizePageHref = (href) => {
  if (!href) {
    return href;
  }

  return href
    .replace(/\/page\/1(?:\.html)?\/?$/, "/")
    .replace(/\/page\/(\d+)\/?$/, "/page/$1.html");
};

const getPageHref = (pageNumber) =>
  pageNumber <= 1
    ? `${basePath}/`.replace(/\/+/g, "/")
    : `${basePath}/page/${pageNumber}.html`.replace(/\/+/g, "/");

const getPageSizeHref = (size) =>
  normalizeBlogPageSize(size) === BLOG_PAGE_SIZE
    ? `${defaultBasePath}/`.replace(/\/+/g, "/")
    : `${defaultBasePath}/per-page/${size}/`.replace(/\/+/g, "/");

const getPageNumbers = () => {
  const currentPage = page?.currentPage ?? 1;
  const lastPage = page?.lastPage ?? 1;

  if (lastPage <= 6) {
    return Array.from({ length: lastPage }, (_, index) => index + 1);
  }

  const numbers = new Set([1, lastPage, currentPage - 1, currentPage, currentPage + 1]);

  return [...numbers]
    .filter((value) => value >= 1 && value <= lastPage)
    .sort((a, b) => a - b)
    .reduce((accumulator, value, index, array) => {
      if (index > 0 && value - array[index - 1] > 1) {
        accumulator.push("ellipsis");
      }

      accumulator.push(value);
      return accumulator;
    }, []);
};

const currentPage = page?.currentPage ?? 1;
const lastPage = page?.lastPage ?? 1;
const previousHref = currentPage > 1 ? normalizePageHref(getPageHref(currentPage - 1)) : undefined;
const nextHref = currentPage < lastPage ? normalizePageHref(getPageHref(currentPage + 1)) : undefined;
const pageNumbers = getPageNumbers();
const selectId = `blog-page-size-${basePath.replace(/[^a-z0-9]+/gi, "-").replace(/^-|-$/g, "") || "blog"}`;
---

{
  page && (
    <div class="blog-pagination-shell">
      <div class="blog-pagination-size">
        <label for={selectId}>Show</label>
        <select
          id={selectId}
          class="blog-pagination-size-select"
          aria-label="Posts per page"
          data-blog-page-size-select
        >
          {
            pageSizeOptions.map((option) => (
              <option
                value={getPageSizeHref(option)}
                selected={normalizeBlogPageSize(option) === currentPageSize}
              >
                {option} posts
              </option>
            ))
          }
        </select>
      </div>
      <nav class="blog-pagination" aria-label="Blog pagination">
        {previousHref ? (
          <a href={previousHref} class="blog-pagination-button" aria-label="Previous page">
            <SiteIcon name="mdi:chevron-left" aria-hidden="true" />
            <span>Prev</span>
          </a>
        ) : (
          <span class="blog-pagination-spacer" aria-hidden="true"></span>
        )}
        <div class="blog-pagination-pages" aria-label="Page links">
          {
            pageNumbers.map((value) =>
              value === "ellipsis" ? (
                <span class="blog-pagination-ellipsis" aria-hidden="true">
                  ...
                </span>
              ) : (
                <a
                  href={getPageHref(value)}
                  class:list={[
                    "blog-pagination-page-link",
                    { "is-active": value === currentPage },
                  ]}
                  aria-current={value === currentPage ? "page" : undefined}
                >
                  {value}
                </a>
              ),
            )
          }
        </div>
        {nextHref ? (
          <a href={nextHref} class="blog-pagination-button" aria-label="Next page">
            <span>Next</span>
            <SiteIcon name="mdi:chevron-right" aria-hidden="true" />
          </a>
        ) : (
          <span class="blog-pagination-spacer" aria-hidden="true"></span>
        )}
      </nav>
      <script is:inline>
        document.addEventListener("change", (event) => {
          const select = event.target.closest("[data-blog-page-size-select]");

          if (!select || !select.value) {
            return;
          }

          window.location.href = select.value;
        });
      </script>
    </div>
  )
}

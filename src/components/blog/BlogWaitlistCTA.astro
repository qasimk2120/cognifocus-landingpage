---
import SiteIcon from "../shared/SiteIcon.astro";
---

<aside class="blog-waitlist-cta" aria-labelledby="blogWaitlistTitle">
  <div class="blog-waitlist-copy">
    <h2 id="blogWaitlistTitle">Want CogniFocus on iOS?</h2>
    <p>
      Join the waitlist and get a quick email when the iPhone version is ready.

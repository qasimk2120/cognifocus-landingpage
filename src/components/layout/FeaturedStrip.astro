const badges = [...managedBadges, ...legacyBadges];
---

<section class="featured-strip" aria-label="Featured on directories">
  <div class="featured-strip-inner">
    <p class="featured-strip-title">Featured on</p>
    <div class="featured-strip-track-wrap" tabindex="0" aria-label="Featured directory badges">
      <div class="featured-strip-track">
        <div class="featured-strip-group">
          {badges.map((badge) => (
            <a
              href={badge.href}
              target="_blank"
              rel="noopener noreferrer"
              title={badge.title}
              class:list={["featured-strip-badge", badge.className]}
              aria-label={badge.label}
              style={badge.isHTML ? "display:inline-flex;align-items:center;text-decoration:none;" : undefined}
            >
              {badge.isHTML ? (
                <Fragment set:html={badge.html} />
              ) : badge.picture ? (
                <picture>
                  <source media="(prefers-color-scheme: light)" srcset={badge.picture.lightSrc} />
                  <img
                    src={badge.picture.darkSrc}
                    alt={badge.picture.alt}
                    title={badge.picture.title}
                    width={badge.picture.width}
                    height={badge.picture.height}
                    loading="lazy"
                    decoding="async"
                  />
                </picture>
              ) : (
                <img
                  src={badge.img.src}
                  alt={badge.img.alt}
                  title={badge.img.title}
                  style={badge.img.style}
                  width={badge.img.width}
                  height={badge.img.height}
                  loading="lazy"
                  decoding="async"
                />
              )}
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
<script>
  (function () {
    const wrap = document.querySelector('.featured-strip-track-wrap');
    if (!wrap) return;
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const track = wrap.querySelector('.featured-strip-track');
    if (!track) return;

    // If there's not enough content to scroll, skip.
    function canScroll() {
      return track.scrollWidth > wrap.clientWidth + 2;
    }

    let rafId = null;
    let last = 0;
    const speed = 40; // pixels per second

    function step(now) {
      if (!last) last = now;
      const dt = (now - last) / 1000;
      last = now;

      if (!canScroll()) {
        cancelAnimationFrame(rafId);
        rafId = null;
        return;
      }

      wrap.scrollLeft += speed * dt;

      // loop when reaching the end
      if (wrap.scrollLeft >= track.scrollWidth - wrap.clientWidth - 1) {
        wrap.scrollLeft = 0;
      }

      rafId = requestAnimationFrame(step);
    }

    function start() {
      if (rafId == null) {
        last = 0;
        rafId = requestAnimationFrame(step);
      }
    }

    function stop() {
      if (rafId != null) {
        cancelAnimationFrame(rafId);
        rafId = null;
      }
    }

    // Pause on hover/focus for accessibility and manual interaction
    wrap.addEventListener('mouseenter', stop);
    wrap.addEventListener('mouseleave', start);
    wrap.addEventListener('focusin', stop);
    wrap.addEventListener('focusout', start);

    // If user scrolls manually (wheel), pause briefly then resume
    let wheelTimeout;
    wrap.addEventListener('wheel', () => {
      stop();
      clearTimeout(wheelTimeout);
      wheelTimeout = setTimeout(start, 1500);
    }, { passive: true });

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        if (canScroll()) start();
      }, { once: true });
    } else {
      if (canScroll()) start();
    }
  })();
</script>

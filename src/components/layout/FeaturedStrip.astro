---
const { yoDirectoryInlineStyle = false } = Astro.props;
---

<section class="featured-strip" aria-label="Featured on directories">
  <div class="featured-strip-inner">
    <p class="featured-strip-title">Featured on</p>
    <div class="featured-strip-track-wrap">
      <div class="featured-strip-track">
        <a
          href="https://www.startupfa.st"
          target="_blank"
          rel="noopener noreferrer"
          title="Powered by Startup Fast"
          class="featured-strip-badge featured-strip-badge-startupfast"
          aria-label="CogniFocus on Startup Fast"
        >
          <img
            src="https://www.startupfa.st/images/badges/powered-by-light.svg"
            alt="Powered by Startup Fast badge"
            width="150"
            height="44"
            loading="lazy"
            decoding="async"
          />
        </a>
        <a
          href="https://dayslaunch.com"
          target="_blank"
          rel="noopener noreferrer"
          class="featured-strip-badge"
          aria-label="CogniFocus on Days Launch"
        >
          <img
            src="https://dayslaunch.com/badages-awards.svg"
            alt="Days Launch badge"
            loading="lazy"
            decoding="async"
            width="150"
            height="44"
          />
        </a>
        <a
          class="featured-strip-badge"
          href="https://www.producthunt.com/products/cognifocus?embed=true&utm_source=badge-featured&utm_medium=badge&utm_campaign=badge-cognifocus"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="CogniFocus on Product Hunt"
        >
          <img
            src="https://api.producthunt.com/widgets/embed-image/v1/featured.svg?post_id=1136007&theme=light&t=1777557337082"
            alt="CogniFocus Product Hunt featured badge"
            loading="lazy"
            decoding="async"
            width="250"
            height="54"
          />
        </a>
        <a
          class="featured-strip-badge"
          href="https://peerpush.net/p/cognifocus"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="CogniFocus on PeerPush"
        >
          <img
            src="https://peerpush.net/p/cognifocus/badge.png"
            alt="CogniFocus PeerPush badge"
            loading="lazy"
            decoding="async"
            width="150"
            height="54"
          />
        </a>
        <a
          target="_blank"
          href="https://startupbenchmarks.com"
          rel="noopener noreferrer"
          class="featured-strip-badge"
          aria-label="CogniFocus on Startup Benchmarks"
        >
          <img
            src="https://startupbenchmarks.com/assets/images/badge.png"
            alt="Startup Benchmarks badge"
            height="54"
            loading="lazy"
            decoding="async"
            width="150"
          />
        </a>
        <a
          href="https://yo.directory/"
          target="_blank"
          rel="noopener noreferrer"
          class="featured-strip-badge"
          aria-label="CogniFocus on Yo Directory"
        >
          <img
            src="https://cdn.prod.website-files.com/65c1546fa73ea974db789e3d/65e1e171f89ebfa7bd0129ac_yodirectory-featured.png"
            alt="Yo Directory featured badge"
            style={yoDirectoryInlineStyle ? "width: 150px; height: 54px" : undefined}
            width="150"
            height="54"
            loading="lazy"
            decoding="async"
          />
        </a>
        <a
          href="https://nicklaunches.com/products/cognifocus/"
          target="_blank"
          rel="noopener noreferrer"
          class="featured-strip-badge"
          aria-label="CogniFocus on Nick Launches"
        >
          <picture>
            <source
              media="(prefers-color-scheme: light)"
              srcset="https://nicklaunches.com/badges/featured.svg"
            />
            <img
              src="https://nicklaunches.com/badges/featured-dark.svg"
              alt="Nick Launches featured badge"
              width="244"
              height="56"
              loading="lazy"
              decoding="async"
            />
          </picture>
        </a>
      </div>
    </div>
  </div>
</section>

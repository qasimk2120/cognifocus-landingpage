---
// GoblinBot — site-wide FAQ chatbot widget
// Keyword-matches against the FAQ knowledge base. Falls back to /support.html.
---

<div id="goblin-bot" class="gbot" aria-live="polite" aria-label="Goblin support chat">
  <!-- Trigger button -->
  <button
    id="gbot-trigger"
    class="gbot-trigger"
    type="button"
    aria-label="Open Goblin chat"
    aria-expanded="false"
    aria-controls="gbot-panel"
  >
    <img
      src="/assets/characters/goblin/face/cheerful.png"
      alt=""
      aria-hidden="true"
      class="gbot-trigger-face gbot-face-cheerful"
      width="44"
      height="44"
      loading="lazy"
      decoding="async"
    />
    <img
      src="/assets/characters/goblin/face/annoyed.png"
      alt=""
      aria-hidden="true"
      class="gbot-trigger-face gbot-face-annoyed"
      width="44"
      height="44"
      loading="lazy"
      decoding="async"
    />
    <span class="gbot-trigger-label">Ask Goblin</span>
    <span class="gbot-trigger-badge" id="gbot-badge" hidden aria-label="New message">1</span>
  </button>

  <!-- Chat panel -->
  <div
    id="gbot-panel"
    class="gbot-panel"
    role="dialog"
    aria-modal="false"
    aria-label="Goblin chat"
    hidden
  >
    <!-- Header -->
    <div class="gbot-header">
      <div class="gbot-header-identity">
        <img
          id="gbot-header-face"
          src="/assets/characters/goblin/face/cheerful.png"
          alt="Goblin"
          class="gbot-header-face"
          width="32"
          height="32"
          loading="lazy"
          decoding="async"
        />
        <div class="gbot-header-meta">
          <span class="gbot-header-name">Goblin</span>
          <span class="gbot-header-status">
            <span class="gbot-status-dot" aria-hidden="true"></span>
            Online
          </span>
        </div>
      </div>
      <button
        id="gbot-close"
        class="gbot-close"
        type="button"
        aria-label="Close Goblin chat"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M12 4L4 12M4 4l8 8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

    <!-- Messages -->
    <div id="gbot-messages" class="gbot-messages" role="log" aria-live="polite" aria-label="Chat messages">
      <!-- Populated by JS -->
    </div>

    <!-- Quick replies -->
    <div id="gbot-quick-replies" class="gbot-quick-replies" aria-label="Quick topics">
      <!-- Populated by JS -->
    </div>

    <!-- Input -->
    <div class="gbot-input-wrap">
      <input
        id="gbot-input"
        type="text"
        class="gbot-input"
        placeholder="Ask me anything..."
        maxlength="200"
        autocomplete="off"
        aria-label="Type your question"
      />
      <button
        id="gbot-send"
        type="button"
        class="gbot-send"
        aria-label="Send message"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M22 2L11 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M22 2L15 22L11 13L2 9L22 2Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
  </div>
</div>


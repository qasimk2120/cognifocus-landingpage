      // ── FAQ & Help pages ────────────────────────────────────────────────────
      {
        keywords: ["faq", "frequently asked", "all questions", "more questions", "help page"],
        mood: "neutral",
        answer: "Everything you might want is on the FAQ page — focus sessions, Shield, Goblin, Pro, privacy, support.",

    const QUICK_REPLIES = [
      { label: "Focus sessions", query: "focus session" },
      { label: "Shield & blocking", query: "shield" },
      { label: "Goblin & progress", query: "goblin" },
      { label: "Pro features", query: "pro" },
      { label: "Privacy", query: "data" },
      { label: "iOS coming?", query: "ios" },
    ];

    const GREETING = {
      mood: "cheerful",
      text: "Yeah, I'm here. What do you need?"
    };

    const FALLBACK = {
      mood: "annoyed",
      text: "That one's beyond me. Head to support and a real human will sort it out.",
      link: { label: "Contact support", href: "/support.html" }
    };

    // ── DOM refs ───────────────────────────────────────────────────────────────
    const bot        = document.getElementById("goblin-bot");
    const trigger    = document.getElementById("gbot-trigger");
    const panel      = document.getElementById("gbot-panel");
    const closeBtn   = document.getElementById("gbot-close");
    const messages   = document.getElementById("gbot-messages");
    const quickArea  = document.getElementById("gbot-quick-replies");
    const input      = document.getElementById("gbot-input") as HTMLInputElement;
    const sendBtn    = document.getElementById("gbot-send");
    const headerFace = document.getElementById("gbot-header-face") as HTMLImageElement;
    const badge      = document.getElementById("gbot-badge");

    if (!bot || !trigger || !panel || !closeBtn || !messages || !quickArea || !input || !sendBtn || !headerFace || !badge) return;

    let isOpen = false;
    let greeted = false;

    // ── Helpers ────────────────────────────────────────────────────────────────
    function setFace(mood: string) {
      const map: Record<string, string> = {
        cheerful: "/assets/characters/goblin/face/cheerful.png",
        annoyed:  "/assets/characters/goblin/face/annoyed.png",
        angry:    "/assets/characters/goblin/face/angry.png",
        neutral:  "/assets/characters/goblin/face/neutral.png",
      };
      headerFace.src = map[mood] ?? map.neutral;
    }

    function addMessage(role: "bot" | "user", text: string, mood?: string, link?: { label: string; href: string }) {
      const wrap = document.createElement("div");
      wrap.className = `gbot-msg gbot-msg-${role}`;

      if (role === "bot" && mood) {
        const face = document.createElement("img");
        face.src = `/assets/characters/goblin/face/${mood}.png`;
        face.alt = "";
        face.className = "gbot-msg-face";
        face.width = 24;
        face.height = 24;
        face.loading = "lazy";
        face.decoding = "async";
        wrap.appendChild(face);
        setFace(mood);
      }

      const bubble = document.createElement("div");
      bubble.className = "gbot-bubble";
      bubble.textContent = text;

      if (link) {
        const a = document.createElement("a");
        a.href = link.href;
        a.textContent = link.label;
        a.className = "gbot-bubble-link";
        bubble.appendChild(document.createElement("br"));
        bubble.appendChild(a);
      }

      wrap.appendChild(bubble);
      messages.appendChild(wrap);
      requestAnimationFrame(() => {
        messages.scrollTop = messages.scrollHeight;
      });
    }

    function addThinkingMessage() {
      const wrap = document.createElement("div");
      wrap.className = "gbot-msg gbot-msg-bot gbot-msg-thinking";
      wrap.setAttribute("aria-label", "Goblin is thinking");

      const face = document.createElement("img");
      face.src = "/assets/characters/goblin/face/neutral.png";
      face.alt = "";
      face.className = "gbot-msg-face";
      face.width = 24;
      face.height = 24;
      face.loading = "lazy";
      face.decoding = "async";

      const bubble = document.createElement("div");
      bubble.className = "gbot-bubble gbot-typing-bubble";
      bubble.setAttribute("aria-hidden", "true");

      for (let i = 0; i < 3; i += 1) {
        const dot = document.createElement("span");
        dot.className = "gbot-typing-dot";
        bubble.appendChild(dot);
      }

      wrap.appendChild(face);
      wrap.appendChild(bubble);
      messages.appendChild(wrap);
      setFace("neutral");

      requestAnimationFrame(() => {
        messages.scrollTop = messages.scrollHeight;
      });

      return wrap;
    }

    function renderQuickReplies(items: typeof QUICK_REPLIES) {
      quickArea.innerHTML = "";
      items.forEach(({ label, query }) => {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "gbot-chip";
        btn.textContent = label;
        btn.addEventListener("click", () => handleQuery(query, label));
        quickArea.appendChild(btn);
      });
    }

    // ── Query engine ─────────────────────────────────────────────────────────────
    const STOP_WORDS = new Set([
      "a","an","the","is","it","its","in","of","to","for","me","my",
      "can","i","do","does","what","how","why","are","be","will","has",
      "have","on","at","or","and","about","that","this","with","from",
      "get","use","tell","want","would","should","could","if","any","all"
    ]);

    function stem(w: string): string {
      if (w.length <= 4) return w;
      if (w.endsWith("ing") && w.length > 6) return w.slice(0, -3);
      if (w.endsWith("tion") && w.length > 7) return w.slice(0, -4);
      if (w.endsWith("ed") && w.length > 5) return w.slice(0, -2);
      if (w.endsWith("er") && w.length > 5) return w.slice(0, -2);
      if (w.endsWith("ly") && w.length > 5) return w.slice(0, -2);
      if (w.endsWith("s") && w.length > 4) return w.slice(0, -1);
      return w;
    }

    function tokenize(text: string): string[] {
      return text
        .toLowerCase()
        .replace(/[^a-z0-9\s]/g, " ")
        .split(/\s+/)
        .filter(t => t.length > 1 && !STOP_WORDS.has(t))
        .map(stem);
    }

    function scoreEntry(qTokens: string[], entry: typeof KB[0]): number {
      let best = 0;
      for (const phrase of entry.keywords) {
        const pTokens = tokenize(phrase);
        if (!pTokens.length) continue;
        const matches = qTokens.filter(qt => pTokens.includes(qt)).length;
        if (!matches) continue;
        const score = matches / Math.max(pTokens.length, qTokens.length);
        if (score > best) best = score;
      }
      return best;
    }

    function findAnswer(raw: string) {
      const qTokens = tokenize(raw);
      if (!qTokens.length) return null;
      let bestEntry: typeof KB[0] | null = null;
      let bestScore = 0;
      for (const entry of KB) {
        const score = scoreEntry(qTokens, entry);
        if (score > bestScore) {
          bestScore = score;
          bestEntry = entry;
        }
      }
      return bestScore >= 0.3 ? bestEntry : null;
    }

    function handleQuery(query: string, displayText?: string) {
      const text = displayText ?? query;
      addMessage("user", text);
      quickArea.innerHTML = "";
      const thinkingMessage = addThinkingMessage();

      setTimeout(() => {
        thinkingMessage.remove();
        const entry = findAnswer(query);
        if (entry) {
          addMessage("bot", entry.answer, entry.mood, entry.link);
        } else {
          addMessage("bot", FALLBACK.text, FALLBACK.mood, FALLBACK.link);
        }
        renderQuickReplies(QUICK_REPLIES);
      }, 3000);
    }

    function openPanel() {
      isOpen = true;
      panel.hidden = false;
      trigger.setAttribute("aria-expanded", "true");
      bot.classList.add("is-open");
      badge.hidden = true;

      if (!greeted) {
        greeted = true;
        setTimeout(() => {
          addMessage("bot", GREETING.text, GREETING.mood);
          renderQuickReplies(QUICK_REPLIES);
        }, 200);
      }

      setTimeout(() => input.focus(), 300);
    }

    function closePanel() {
      isOpen = false;
      panel.hidden = true;
      trigger.setAttribute("aria-expanded", "false");
      bot.classList.remove("is-open");
      trigger.focus();
    }

    // ── Events ─────────────────────────────────────────────────────────────────
    trigger.addEventListener("click", () => isOpen ? closePanel() : openPanel());
    closeBtn.addEventListener("click", closePanel);

    sendBtn.addEventListener("click", () => {
      const val = input.value.trim();
      if (!val) return;
      handleQuery(val);
      input.value = "";
    });

    input.addEventListener("keydown", (e) => {
      if (e.key === "Enter") {
        const val = input.value.trim();
        if (!val) return;
        handleQuery(val);
        input.value = "";
      }
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && isOpen) closePanel();
    });

    // Show badge after 8s if user hasn't opened yet
    setTimeout(() => {
      if (!greeted) {
        badge.hidden = false;
        bot.classList.add("has-badge");
      }
    }, 8000);
  })();
</script>

        link: { label: "What's new", href: "/whats-new.html" }
      },

      // ── General catch-alls ──────────────────────────────────────────────────
      {
        keywords: ["is it free", "free to download", "free app", "does it cost money"],
        mood: "cheerful",
        answer: "Yes — free to download, free to start. No credit card. Core sessions, basic blocking, and Goblin reactions are all in the free plan.",

---
import BaseLayout from "../layouts/BaseLayout.astro";
import supportStylesheet from "../styles/pages/support.css?url";

const title = "Support | CogniFocus";
const description =
  "Contact CogniFocus support about bugs, account help, billing, privacy requests, deletion help, or feature ideas.";
const canonical = "https://cognifocus.app/support.html";
const ogTitle = "CogniFocus support";
const ogDescription =
  "Tell us what broke, what confused you, or what the Goblin failed to prevent";
const supportCopy = {
  meta: {
    ogImageAlt: "CogniFocus support page",
  },
  hero: {
    kicker: "Support",
    headlinePrefix: "Need",
    headlineEmphasis: "help?",
  },
  card: {
    headline: "Goblin's listening",
    subtext: "Bug, billing issue, or just confused - drop it here.",
    helper:
      "Keep it short and specific. If you can, mention the screen you were on, the exact step that failed, and any message you saw.",
    warning:
      "Account or deletion requests? Use the email tied to your CogniFocus account.",
    linksLabel: "Helpful support links",
    faq: "FAQ",
    deleteAccount: "Delete account",
    privacy: "Privacy",
  },
  form: {
    nameLabel: "Name",
    optionalLabel: "optional",
    namePlaceholder: "What should we call you?",
    emailLabel: "Email",
    emailPlaceholder: "you@example.com",
    topicLabel: "Topic",
    topicPlaceholder: "Choose a topic",
    topicOptions: {
      bug: "Bug report",
      account: "Account help",
      billing: "Billing / premium",
      privacy: "Privacy request",
      deleteAccount: "Delete account",
      featureRequest: "Feature request",
      other: "Other",
    },
    messageLabel: "Message",
    messagePlaceholder: "What happened? Be as specific as you can.",
    websiteLabel: "Website",
    submitLabel: "Send request",
    statusRole: "status",
  },
  turnstile: {
    title: "One sec - quick check",
    body: "Just making sure you're not a bot. Goblin's watching.",
    closeLabel: "Close verification",
  },
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  ogImageAlt={supportCopy.meta.ogImageAlt}
  bodyClass="support-page cf-shell"
  showFeaturedStrip={false}
  bootstrapIconsFirst={true}
  stylesheets={[supportStylesheet]}
>
  <script
    slot="head"
    src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"
    async
    defer
  ></script>

  <main id="main-content" class="support-main">
    <header class="container support-hero">
      <span class="feature-kicker support-eyebrow">
        {supportCopy.hero.kicker}
      </span>
      <h1>
        {supportCopy.hero.headlinePrefix}{" "}
        <span class="hero-heading-line hero-heading-accent">
          {supportCopy.hero.headlineEmphasis}
        </span>
      </h1>
    </header>

    <section class="container support-content">
      <section class="support-card" aria-labelledby="supportHeroTitle">
        <div class="support-card-copy">
          <h2 id="supportHeroTitle">{supportCopy.card.headline}</h2>
          <p>{supportCopy.card.subtext}</p>
          <p>{supportCopy.card.helper}</p>
          <p class="support-note support-note-alert">
            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
            <span class="support-note__text">
              {supportCopy.card.warning}
            </span>
          </p>

          <div class="support-links" aria-label={supportCopy.card.linksLabel}>
            <a href="/faq.html" class="support-chip">
              <i class="bi bi-chat-square-text" aria-hidden="true"></i>
              <span>{supportCopy.card.faq}</span>
            </a>
            <a href="/delete-account.html" class="support-chip">
              <i class="bi bi-shield-lock-fill" aria-hidden="true"></i>
              <span>{supportCopy.card.deleteAccount}</span>
            </a>
            <a href="/privacy.html" class="support-chip">
              <i class="bi bi-file-earmark-text" aria-hidden="true"></i>
              <span>{supportCopy.card.privacy}</span>
            </a>
          </div>
        </div>

        <form class="support-form" id="supportForm" novalidate>
          <div class="support-field">
            <label for="supportName">
              {supportCopy.form.nameLabel} <span>{supportCopy.form.optionalLabel}</span>
            </label>
            <input
              id="supportName"
              name="name"
              type="text"
              autocomplete="name"
              maxlength="80"
              placeholder={supportCopy.form.namePlaceholder}
            />
          </div>

          <div class="support-field">
            <label for="supportEmail">{supportCopy.form.emailLabel}</label>
            <input
              id="supportEmail"
              name="email"
              type="email"
              autocomplete="email"
              inputmode="email"
              required
              placeholder={supportCopy.form.emailPlaceholder}
            />
          </div>

          <div class="support-field">
            <label for="supportTopic">{supportCopy.form.topicLabel}</label>
            <div class="support-field__select-wrap">
              <select id="supportTopic" name="topic" required>
                <option value="" selected disabled>
                  {supportCopy.form.topicPlaceholder}
                </option>
                <option value="bug">{supportCopy.form.topicOptions.bug}</option>
                <option value="account">{supportCopy.form.topicOptions.account}</option>
                <option value="billing">{supportCopy.form.topicOptions.billing}</option>
                <option value="privacy">{supportCopy.form.topicOptions.privacy}</option>
                <option value="delete_account">
                  {supportCopy.form.topicOptions.deleteAccount}
                </option>
                <option value="feature_request">
                  {supportCopy.form.topicOptions.featureRequest}
                </option>
                <option value="other">{supportCopy.form.topicOptions.other}</option>
              </select>
            </div>
          </div>

          <div class="support-field">
            <label for="supportMessage">{supportCopy.form.messageLabel}</label>
            <textarea
              id="supportMessage"
              name="message"
              rows="6"
              required
              placeholder={supportCopy.form.messagePlaceholder}
            ></textarea>
          </div>

          <div class="support-honeypot" aria-hidden="true">
            <label for="supportWebsite">{supportCopy.form.websiteLabel}</label>
            <input
              id="supportWebsite"
              name="website"
              type="text"
              tabindex="-1"
              autocomplete="off"
            />
          </div>

          <button
            type="submit"
            class="btn btn-glow support-submit"
            id="supportSubmit"
          >
            <span class="support-submit__icon" aria-hidden="true">
              <i class="bi bi-send-fill"></i>
            </span>
            <span class="support-submit__label">{supportCopy.form.submitLabel}</span>
          </button>

          <div
            class="support-message"
            id="supportMessageStatus"
            role={supportCopy.form.statusRole}
            aria-live="polite"
            hidden
          ></div>
        </form>

        <aside
          class="turnstile-modal support-turnstile-modal"
          id="supportTurnstileModal"
          role="dialog"
          aria-modal="true"
          aria-labelledby="supportTurnstileTitle"
          aria-describedby="supportTurnstileBody"
          hidden
        >
          <div class="turnstile-modal__panel">
            <button
              type="button"
              class="turnstile-modal__close"
              id="supportTurnstileClose"
              aria-label={supportCopy.turnstile.closeLabel}
            >
              <i class="bi bi-x-lg" aria-hidden="true"></i>
            </button>
            <div class="turnstile-modal__copy">
              <h2 id="supportTurnstileTitle">{supportCopy.turnstile.title}</h2>
              <p id="supportTurnstileBody">{supportCopy.turnstile.body}</p>
              <p
                class="turnstile-modal__message"
                id="supportTurnstileMessage"
                aria-live="polite"
                hidden
              ></p>
            </div>
            <div
              class="turnstile-modal__widget"
              id="supportTurnstileWidget"
            ></div>
          </div>
        </aside>
      </section>
    </section>
  </main>

  <script>
    import "../scripts/entries/support.js";
  </script>
</BaseLayout>

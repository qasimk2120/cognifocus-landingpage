---
import BaseLayout from "../layouts/BaseLayout.astro";
import supportStylesheet from "../styles/pages/support.css?url";

const title = "Support | CogniFocus";
const description =
  "Contact CogniFocus support about bugs, account help, billing, privacy requests, deletion help, or feature ideas.";
const canonical = "https://cognifocus.app/support.html";
const ogTitle = "CogniFocus support";
const ogDescription =
  "Tell us what broke, what confused you, or what the Goblin failed to prevent";
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  ogImageAlt="CogniFocus support page"
  bodyClass="support-page cf-shell"
  showFeaturedStrip={false}
  bootstrapIconsFirst={true}
  stylesheets={[supportStylesheet]}
>
  <script
    slot="head"
    src="https://challenges.cloudflare.com/turnstile/v0/api.js"
    async
    defer
  ></script>

  <main id="main-content" class="support-main">
    <header class="container support-hero">
      <span class="feature-kicker support-eyebrow">Support</span>
      <h1>Need help?</h1>
      <p class="support-subtitle">
        Tell us what broke, what confused you, or what the Goblin failed to
        prevent.
      </p>
    </header>

    <section class="container support-content">
      <section class="support-card" aria-labelledby="supportCardTitle">
        <div class="support-card-copy">
          <span class="feature-kicker support-card-eyebrow">
            Fast, direct help
          </span>
          <h2 id="supportCardTitle">
            
          </h2>
          <p>
            Keep it short and specific. If you can, mention the screen you were
            on, the exact step that failed, and any message you saw
          </p>
          <p class="support-note">
            For account or deletion requests, use the email tied to your
            CogniFocus account
          </p>

          <div class="support-links" aria-label="Helpful support links">
            <a href="/faq.html" class="support-chip">
              <i class="bi bi-chat-square-text" aria-hidden="true"></i>
              <span>FAQ</span>
            </a>
            <a href="/delete-account.html" class="support-chip">
              <i class="bi bi-shield-lock-fill" aria-hidden="true"></i>
              <span>Delete account</span>
            </a>
            <a href="/privacy.html" class="support-chip">
              <i class="bi bi-file-earmark-text" aria-hidden="true"></i>
              <span>Privacy</span>
            </a>
          </div>
        </div>

        <form class="support-form" id="supportForm" novalidate>
          <div class="support-field">
            <label for="supportName">Name <span>optional</span></label>
            <input
              id="supportName"
              name="name"
              type="text"
              autocomplete="name"
              maxlength="80"
              placeholder="Your name"
            />
          </div>

          <div class="support-field">
            <label for="supportEmail">Email</label>
            <input
              id="supportEmail"
              name="email"
              type="email"
              autocomplete="email"
              inputmode="email"
              required
              placeholder="you@example.com"
            />
          </div>

          <div class="support-field">
            <label for="supportTopic">Topic</label>
            <select id="supportTopic" name="topic" required>
              <option value="" selected disabled>Choose a topic</option>
              <option value="Bug report">Bug report</option>
              <option value="Account help">Account help</option>
              <option value="Billing / premium">Billing / premium</option>
              <option value="Privacy request">Privacy request</option>
              <option value="Delete account">Delete account</option>
              <option value="Feature request">Feature request</option>
              <option value="Other">Other</option>
            </select>
          </div>

          <div class="support-field">
            <label for="supportMessage">Message</label>
            <textarea
              id="supportMessage"
              name="message"
              rows="6"
              required
              placeholder="Tell us what happened, what you expected, and anything that helps us reproduce it"
            ></textarea>
          </div>

          <div class="support-honeypot" aria-hidden="true">
            <label for="supportWebsite">Website</label>
            <input
              id="supportWebsite"
              name="website"
              type="text"
              tabindex="-1"
              autocomplete="off"
            />
          </div>

          <div
            class="cf-turnstile support-turnstile"
            data-sitekey="0x4AAAAAADR7PaDsKmcbHtqJ"
            data-theme="auto"
          ></div>

          <button
            type="submit"
            class="btn btn-glow support-submit"
            id="supportSubmit"
          >
            <span class="support-submit__icon" aria-hidden="true">
              <i class="bi bi-send-fill"></i>
            </span>
            <span class="support-submit__label">Send request</span>
          </button>

          <div
            class="support-message"
            id="supportMessageStatus"
            role="status"
            aria-live="polite"
            hidden
          ></div>
        </form>
      </section>
    </section>
  </main>

  <script>
    import "../scripts/entries/support.js";
  </script>
</BaseLayout>

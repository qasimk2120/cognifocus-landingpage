---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "CogniFocus for iOS Waitlist | iPhone Focus App";
const description = "Join the CogniFocus iOS waitlist and get an email when the iPhone version is ready. CogniFocus is already live on Android.";
const canonical = "https://cognifocus.app/ios-waitlist.html";
const ogTitle = "CogniFocus for iOS is coming";
const ogDescription = "Join the waitlist and we will email you when the iPhone version is ready.";
const schemaJson = "{\n        \"@context\": \"https://schema.org\",\n        \"@type\": \"WebPage\",\n        \"name\": \"CogniFocus for iOS Waitlist\",\n        \"url\": \"https://cognifocus.app/ios-waitlist.html\",\n        \"description\": \"Join the CogniFocus iOS waitlist and get an email when the iPhone version is ready.\",\n        \"isPartOf\": {\n          \"@type\": \"WebSite\",\n          \"name\": \"CogniFocus\",\n          \"url\": \"https://cognifocus.app/\"\n        },\n        \"about\": {\n          \"@type\": \"SoftwareApplication\",\n          \"name\": \"CogniFocus\",\n          \"applicationCategory\": \"ProductivityApplication\",\n          \"operatingSystem\": \"Android\",\n          \"url\": \"https://cognifocus.app/\",\n          \"downloadUrl\": \"https://play.google.com/store/apps/details?id=io.ionic.cognifocus\"\n        },\n        \"publisher\": {\n          \"@type\": \"Organization\",\n          \"name\": \"CogniElevate\",\n          \"url\": \"https://cognifocus.app/\"\n        }\n      }";
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  ogImageAlt="CogniFocus iOS waitlist page"
  bodyClass="ios-waitlist-page cf-shell"
  baseStylesheet="style.css?v=20260515-1"
  includeDefaultBootstrapIcons={false}
  stylesheetsBeforeBase={["https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css"]}
  stylesheets={["ios-waitlist.css?v=20260515-1"]}
  sharedScriptSrc="shared.js?v=20260515-1"
  footerProps={{ includePinterest: true, faqHref: "/#faq", includeIosWaitlist: true }}
  showFeaturedStrip={false}
>
  <link slot="head-after-social" href="https://fonts.googleapis.com/css2?family=Funnel+Display:wght@400..800&family=Funnel+Sans:wght@300..800&display=swap" rel="stylesheet" />
  <script slot="head" type="application/ld+json" set:html={schemaJson} />
  <script slot="head" src="ios-waitlist.js?v=20260515-1" defer is:inline></script>
  <script slot="head" type="text/javascript" is:inline>
    (function (c, l, a, r, i, t, y) {
      c[a] =
        c[a] ||
        function () {
          (c[a].q = c[a].q || []).push(arguments);
        };
      t = l.createElement(r);
      t.async = 1;
      t.src = "https://www.clarity.ms/tag/" + i;
      y = l.getElementsByTagName(r)[0];
      y.parentNode.insertBefore(t, y);
    })(window, document, "clarity", "script", "wq6znd4re5");
  </script>

  <main id="main-content">
      <section class="ios-waitlist-form-section">
        <div class="container">
          <section
            class="ios-waitlist-conversion-card"
            aria-labelledby="iosWaitlistFormTitle"
          >
            <div class="ios-waitlist-form-col">
              <div class="ios-waitlist-form-copy">
                <span class="feature-kicker ios-waitlist-card-eyebrow"
                  >iOS waitlist</span
                >
                <h1 id="iosWaitlistFormTitle">
                  <span class="hero-heading-line">CogniFocus for</span>
                  <span class="hero-heading-line hero-heading-accent"
                    >iOS is coming.</span
                  >
                </h1>
                <p id="iosWaitlistIntro">
                  Join the waitlist. We&rsquo;ll email you when the iPhone
                  version is ready. No fake date. No corporate nonsense.
                </p>
              </div>

              <form class="ios-waitlist-form" id="iosWaitlistForm" novalidate>
                <div class="ios-waitlist-field">
                  <label for="iosWaitlistEmail">Email</label>
                  <input
                    id="iosWaitlistEmail"
                    name="email"
                    type="email"
                    autocomplete="email"
                    inputmode="email"
                    required
                    placeholder="you@example.com"
                  />
                </div>

                <div class="ios-waitlist-field">
                  <label for="iosWaitlistName"
                    >Name <span>optional</span></label
                  >
                  <input
                    id="iosWaitlistName"
                    name="name"
                    type="text"
                    autocomplete="name"
                    placeholder="What should the Goblin call you?"
                  />
                </div>

                <div class="ios-waitlist-honeypot" aria-hidden="true">
                  <label for="iosWaitlistWebsite">Website</label>
                  <input
                    id="iosWaitlistWebsite"
                    name="website"
                    type="text"
                    tabindex="-1"
                    autocomplete="off"
                  />
                </div>

                <button
                  type="submit"
                  class="btn btn-glow ios-waitlist-submit ios-animated-cta"
                  id="iosWaitlistSubmit"
                >
                  <i class="bi bi-apple" aria-hidden="true"></i>
                  <span>Join the iOS waitlist</span>
                </button>
              </form>

              <div
                class="ios-waitlist-message"
                id="iosWaitlistMessage"
                role="status"
                aria-live="polite"
                hidden
              ></div>
            </div>

            <div class="ios-waitlist-animation-col" aria-hidden="true">
              <div
                class="hero-media-card attention-vacuum-demo ios-waitlist-vortex"
              >
                <div class="vacuum-orbit" aria-hidden="true">
                  <span class="vacuum-particle vacuum-particle-one"></span>
                  <span class="vacuum-particle vacuum-particle-two"></span>
                  <span class="vacuum-particle vacuum-particle-three"></span>
                  <div class="vacuum-core">
                    <span class="vacuum-core-ring"></span>
                    <span class="vacuum-core-pulse"></span>
                  </div>

                  <span class="vacuum-app-icon vacuum-app-ig">
                    <i class="bi bi-instagram" aria-hidden="true"></i>
                    <span class="vacuum-cross"></span>
                  </span>
                  <span class="vacuum-app-icon vacuum-app-tiktok">
                    <i class="bi bi-tiktok" aria-hidden="true"></i>
                    <span class="vacuum-cross"></span>
                  </span>
                  <span class="vacuum-app-icon vacuum-app-x">
                    <i class="bi bi-twitter-x" aria-hidden="true"></i>
                    <span class="vacuum-cross"></span>
                  </span>
                  <span class="vacuum-app-icon vacuum-app-yt">
                    <i class="bi bi-youtube" aria-hidden="true"></i>
                    <span class="vacuum-cross"></span>
                  </span>
                  <span class="vacuum-app-icon vacuum-app-reddit">
                    <i class="bi bi-reddit" aria-hidden="true"></i>
                    <span class="vacuum-cross"></span>
                  </span>
                  <span class="vacuum-app-icon vacuum-app-facebook">
                    <i class="bi bi-facebook" aria-hidden="true"></i>
                    <span class="vacuum-cross"></span>
                  </span>

                  <div class="vacuum-goblin-success">
                    <img
                      src="assets/characters/goblin/face/cheerful.png"
                      alt=""
                      loading="eager"
                      decoding="async"
                      width="240"
                      height="240"
                    />
                    <span>Focus saved</span>
                  </div>
                </div>
              </div>
            </div>

            <div class="ios-waitlist-card-divider" aria-hidden="true"></div>

            <div class="ios-waitlist-card-footer">
              <div class="ios-android-card" aria-labelledby="androidCtaTitle">
                <div>
                  <span class="ios-android-eyebrow">Already on Android?</span>
                  <h2 id="androidCtaTitle">
                    CogniFocus is already live on Android.
                  </h2>
                </div>
                <a
                  href="/download.html"
                  class="btn btn-primary ios-android-link ios-animated-cta"
                >
                  Download for Android
                  <i class="bi bi-google-play" aria-hidden="true"></i>
                </a>
              </div>
            </div>
          </section>
        </div>
      </section>
    </main>
</BaseLayout>

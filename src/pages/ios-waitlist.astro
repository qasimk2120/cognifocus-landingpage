---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteIcon from "../components/shared/SiteIcon.astro";
import DemoVideo from "../components/shared/DemoVideo.astro";

const title = "Focus Timer & App Blocker for iPhone | CogniFocus iOS Waitlist";
const description = "Looking for a focus timer and app blocker for iPhone? CogniFocus is coming to iOS. Join the waitlist to be first when it ships.";
const canonical = "https://cognifocus.app/ios-waitlist.html";
const ogTitle = "CogniFocus for iOS is coming";
const ogDescription = "The Goblin is coming to iPhone. Join the CogniFocus iOS waitlist and be first to know when it drops.";
const schemaJson = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "CogniFocus for iOS Waitlist",
  "url": "https://cognifocus.app/ios-waitlist.html",
  "description": "Join the CogniFocus iOS waitlist and get an email when the iPhone version is ready.",
  "isPartOf": {
    "@type": "WebSite",
    "name": "CogniFocus",
    "url": "https://cognifocus.app/"
  },
  "about": {
    "@type": "Thing",
    "name": "CogniFocus iOS waitlist",
    "description": "CogniFocus is available now on Android, and the iOS version is in development."
  },
  "publisher": {
    "@type": "Organization",
    "name": "CogniElevate",
    "url": "https://cognifocus.app/"
  }
});
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  ogImageAlt="CogniFocus iOS waitlist page"
  bodyClass="ios-waitlist-page cf-shell"
  footerProps={{ includePinterest: true, faqHref: "/#faq", includeIosWaitlist: true }}
  showFeaturedStrip={false}
>
  <link slot="head-after-social" href="https://fonts.googleapis.com/css2?family=Funnel+Display:wght@400..800&family=Funnel+Sans:wght@300..800&display=swap" rel="stylesheet" />
  <script slot="head" type="application/ld+json" set:html={schemaJson} />
  <script
    slot="head"
    src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"
    async
    defer
  ></script>

  <main id="main-content">
      <section class="ios-waitlist-form-section">
        <div class="container">
          <section
            class="ios-waitlist-conversion-card"
            aria-labelledby="iosWaitlistFormTitle"
          >
            <div class="ios-waitlist-form-col">
              <div class="ios-waitlist-form-copy">
                <span class="feature-kicker ios-waitlist-card-eyebrow"
                  >iOS waitlist</span
                >
                <h1 id="iosWaitlistFormTitle">
                  <span class="hero-heading-line">CogniFocus for</span>
                  <span class="hero-heading-line hero-heading-accent"
                    >iOS is coming</span
                  >
                </h1>
                <p id="iosWaitlistIntro" class="ios-waitlist-subtitle">
                  We&rsquo;ll let you know when it drops.
                </p>
                <p class="ios-waitlist-subtitle mb-0">
                  More companions dropping on iOS too. Goblin's just first.
                </p>
              </div>

              <form class="ios-waitlist-form" id="iosWaitlistForm" novalidate>
                <div class="ios-waitlist-field">
                  <label for="iosWaitlistEmail">Email</label>
                  <input
                    id="iosWaitlistEmail"
                    name="email"
                    type="email"
                    autocomplete="email"
                    inputmode="email"
                    required
                    placeholder="you@example.com"
                  />
                </div>

                <div class="ios-waitlist-field">
                  <label for="iosWaitlistName"
                    >Name <span>optional</span></label
                  >
                  <input
                    id="iosWaitlistName"
                    name="name"
                    type="text"
                    autocomplete="name"
                    placeholder="What should the Goblin call you?"
                  />
                </div>

                <div class="ios-waitlist-honeypot" aria-hidden="true">
                  <label for="iosWaitlistWebsite">Website</label>
                  <input
                    id="iosWaitlistWebsite"
                    name="website"
                    type="text"
                    tabindex="-1"
                    autocomplete="off"
                  />
                </div>

                <button
                  type="submit"
                  class="btn btn-glow ios-waitlist-submit ios-animated-cta"
                  id="iosWaitlistSubmit"
                >
                  <span class="ios-waitlist-submit__icon" aria-hidden="true">
                    <SiteIcon name="mdi:bell-outline" aria-hidden="true" />
                  </span>
                  <span>Get Notified When We Launch</span>
                </button>
              </form>

              <div
                class="ios-waitlist-message"
                id="iosWaitlistMessage"
                role="status"
                aria-live="polite"
                hidden
              ></div>
            </div>

            <div class="ios-waitlist-animation-col">
              <p class="ios-waitlist-demo-subtext">See CogniFocus fight distractions in 34 seconds</p>
              <div class="ios-waitlist-demo-media">
                <DemoVideo controls={true} autoplay={false} loop={false} muted={false} />
              </div>
            </div>

            <div class="ios-waitlist-card-divider" aria-hidden="true"></div>

            <div class="ios-waitlist-card-footer">
              <div class="ios-android-card" aria-labelledby="androidCtaTitle">
                <div>
                  <span class="ios-android-eyebrow">Already on Android?</span>
                  <h2 id="androidCtaTitle">
                    CogniFocus is already live on Android.
                  </h2>
                </div>
                <a
                  href="/download.html"
                  class="btn btn-primary ios-android-link ios-animated-cta"
                >
                  <span class="cta-playstore-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" role="img" focusable="false">
                      <path
                        fill="#00d26a"
                        d="M3.3 2.5L14.7 14 3.3 21.5c-.4-.2-.6-.6-.6-1V4c0-.4.2-.8.6-1z"
                      />
                      <path
                        fill="#00a0ff"
                        d="M18.4 11.5l-3.7-2.1L10.9 12l3.8 2.6 3.7-2.1c.8-.4.8-1.4 0-1.9z"
                      />
                      <path
                        fill="#ffe000"
                        d="M3.3 2.5l11.4 11.5 3.7-2.1L6.8 5.3 3.3 2.5z"
                      />
                      <path
                        fill="#ff4f5e"
                        d="M3.3 21.5l3.5-2.8 11.6-6.8-3.7-2.1L3.3 21.5z"
                      />
                    </svg>
                  </span>
                  <span>Download for Android</span>
                </a>
              </div>
            </div>

            <aside
              class="turnstile-modal ios-waitlist-turnstile-modal"
              id="iosWaitlistTurnstileModal"
              role="dialog"
              aria-modal="true"
              aria-labelledby="iosWaitlistTurnstileTitle"
              aria-describedby="iosWaitlistTurnstileBody"
              hidden
            >
              <div class="turnstile-modal__panel">
                <button
                  type="button"
                  class="turnstile-modal__close"
                  id="iosWaitlistTurnstileClose"
                  aria-label="Close verification"
                >
                  <SiteIcon name="mdi:close" aria-hidden="true" />
                </button>
                <div class="turnstile-modal__copy">
                  <h2 id="iosWaitlistTurnstileTitle">One sec &#124; quick check</h2>
                  <p id="iosWaitlistTurnstileBody">
                    Just making sure you&rsquo;re not a bot. Goblin&rsquo;s
                    watching.
                  </p>
                  <p
                    class="turnstile-modal__message"
                    id="iosWaitlistTurnstileMessage"
                    aria-live="polite"
                    hidden
                  ></p>
                </div>
                <div
                  class="turnstile-modal__widget"
                  id="iosWaitlistTurnstileWidget"
                ></div>
              </div>
            </aside>
          </section>
        </div>
      </section>
    </main>
  <script>
    import "../scripts/entries/ios-waitlist.js";
  </script>
</BaseLayout>



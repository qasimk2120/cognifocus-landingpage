---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Privacy Policy | CogniFocus";
const description =
  "Read the CogniFocus Privacy Policy for account data, local storage, Firebase services, permissions, support requests, subscriptions, analytics, and deletion controls.";
const canonical = "https://cognifocus.app/privacy.html";
const privacySchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Privacy Policy",
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage="https://cognifocus.app/assets/logo/app-logo.png"
  ogImageAlt="CogniFocus privacy policy page"
  includeOgSiteName={false}
  twitterAttribute="property"
  bodyClass="privacy-page policy-page cf-shell"
  bootstrapIconsFirst={true}
  footerProps={{ includePinterest: true }}
  featuredStripProps={{ yoDirectoryInlineStyle: true }}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(privacySchema, null, 2)} />
  <script slot="head" type="text/javascript" is:inline>
    (function (c, l, a, r, i, t, y) {
      c[a] =
        c[a] ||
        function () {
          (c[a].q = c[a].q || []).push(arguments);
        };
      t = l.createElement(r);
      t.async = 1;
      t.src = "https://www.clarity.ms/tag/" + i;
      y = l.getElementsByTagName(r)[0];
      y.parentNode.insertBefore(t, y);
    })(window, document, "clarity", "script", "wq6znd4re5");
  </script>

  <header class="privacy-hero">
    <h1>Privacy Policy</h1>
    <p class="privacy-keyword-variation">Privacy Policy for CogniFocus.</p>
    <p class="privacy-subtitle">
      Last updated: April 18, 2026. CogniFocus helps you manage focus sessions,
      block distracting apps, track progress, use character-based motivation,
      and manage premium features.
    </p>
  </header>

  <main class="privacy-main">
    <section class="privacy-card privacy-summary-card">
      <div class="privacy-card-header">
        <div class="privacy-icon" aria-hidden="true">&#128187;</div>
        <div>
          <h2>Data Stored On Your Device</h2>
          <p>
            CogniFocus stores some data locally on your device so core app
            features can work.
          </p>
        </div>
      </div>
      <ul class="privacy-list">
        <li>App state and preferences</li>
        <li>Theme, motion, accessibility, and color settings</li>
        <li>Selected blocked apps</li>
        <li>Focus session state and planned sessions</li>
        <li>Nudge cooldowns and reminder state</li>
        <li>Some progress and session-related data</li>
      </ul>
      <p>
        Locally stored data may be removed when you clear app data, delete your
        account from Settings, or uninstall the app.
      </p>
    </section>

    <section class="privacy-card privacy-card-highlight">
      <div class="privacy-card-header">
        <div class="privacy-icon" aria-hidden="true">&#128273;</div>
        <div>
          <h2>Accounts And Authentication</h2>
          <p>
            CogniFocus uses Firebase Authentication to create an anonymous user
            account by default.
          </p>
        </div>
      </div>
      <p>
        If Google linking is added or enabled later, Google sign-in will link to
        your existing anonymous account instead of replacing it. This helps
        protect your progress and premium access across reinstalls or devices.
      </p>
      <p>
        We may store your Firebase user ID to connect app data to your account.
      </p>
    </section>

    <section class="privacy-card">
      <div class="privacy-card-header">
        <div class="privacy-icon" aria-hidden="true">&#128450;</div>
        <div>
          <h2>Data Collected And Stored</h2>
          <p>
            CogniFocus may store user-linked app data in Firebase Firestore.
          </p>
        </div>
      </div>
      <ul class="privacy-list">
        <li>Firebase user ID, profile settings, and onboarding state</li>
        <li>
          Platform, app version, timestamps, and premium/subscription status
          fields
        </li>
        <li>Daily stats, streak and progress data, and planned session data</li>
        <li>Support request records and account deletion records</li>
      </ul>
      <p>
        This data is used to operate app features, maintain progress, support
        syncing where available, process and reflect subscription status,
        provide support, improve reliability, and prevent abuse.
      </p>
    </section>

    <section class="privacy-card">
      <div class="privacy-card-header">
        <div class="privacy-icon" aria-hidden="true">&#9993;</div>
        <div>
          <h2>Support Requests</h2>
          <p>
            When you contact support, CogniFocus may store support details.
          </p>
        </div>
      </div>
      <ul class="privacy-list">
        <li>The message you submit, optional name, and optional email address</li>
        <li>
          Firebase user ID, app version, platform, and session/support context
        </li>
        <li>Recent app actions/logs and recent error details</li>
      </ul>
      <p>
        This information is used to reply to you, debug issues, rate-limit
        abuse, and improve app reliability. Support free-text is not used for
        analytics.
      </p>
    </section>

    <section class="privacy-card">
      <div class="privacy-card-header">
        <div class="privacy-icon" aria-hidden="true">&#128737;</div>
        <div>
          <h2>Permissions</h2>
          <p>
            CogniFocus may request Android permissions to enable Shield and
            app-blocking features.
          </p>
        </div>
      </div>
      <p>
        <strong>Usage Access:</strong> CogniFocus uses Usage Access to detect
        which apps you open so Shield can catch distractions. It does not read
        messages or in-app content.
      </p>
      <p>
        <strong>Display Over Other Apps:</strong> CogniFocus uses Overlay
        permission to show a blocking screen over distracting apps when Shield
        or Manual Block needs to interrupt you.
      </p>
      <p>
        You can revoke these permissions at any time through your device
        settings. Some features may not work correctly without them.
      </p>
    </section>

    <section class="privacy-card">
      <div class="privacy-card-header">
        <div class="privacy-icon" aria-hidden="true">&#128179;</div>
        <div>
          <h2>Subscriptions And Purchases</h2>
          <p>
            CogniFocus uses RevenueCat and Google Play to manage subscription
            products, entitlement status, purchase restoration, and subscription
            management.
          </p>
        </div>
      </div>
      <p>
        CogniFocus may receive subscription-related information such as whether
        your account has active Pro access. Payment details are handled by
        Google Play and are not stored by CogniFocus.
      </p>
      <p>
        Anonymous users can purchase Pro. Linking Google later helps protect
        restore access across reinstalls and devices.
      </p>
    </section>

    <section class="privacy-card">
      <div class="privacy-card-header">
        <div class="privacy-icon" aria-hidden="true">&#128202;</div>
        <div>
          <h2>Analytics And Diagnostics</h2>
          <p>
            CogniFocus uses Firebase services to understand app usage and
            improve reliability.
          </p>
        </div>
      </div>
      <p>
        Firebase Analytics, Crashlytics, and Performance Monitoring may be used
        to detect crashes, diagnose performance issues, and improve reliability.
      </p>
      <p>
        Analytics and diagnostics may include app events, device/platform
        information, crash logs, performance traces, and feature usage signals.
      </p>
    </section>

    <section class="privacy-card">
      <div class="privacy-card-header">
        <div class="privacy-icon" aria-hidden="true">&#128279;</div>
        <div>
          <h2>Third-Party Services</h2>
          <p>
            CogniFocus uses trusted providers to operate app functionality.
          </p>
        </div>
      </div>
      <ul class="privacy-list">
        <li>Firebase Authentication</li>
        <li>Firebase Cloud Firestore</li>
        <li>Firebase Analytics</li>
        <li>Firebase Crashlytics</li>
        <li>Firebase Performance Monitoring</li>
        <li>RevenueCat</li>
        <li>Google Play billing/subscription services</li>
      </ul>
      <p>
        These providers process data on our behalf to provide authentication,
        cloud storage, diagnostics, analytics, purchase handling, and app
        functionality. CogniFocus does not sell your personal data.
      </p>
    </section>

    <section class="privacy-card">
      <div class="privacy-card-header">
        <div class="privacy-icon" aria-hidden="true">&#127760;</div>
        <div>
          <h2>Cookies and similar technologies</h2>
        </div>
      </div>
      <p>
        CogniFocus uses Microsoft Clarity on this website to understand page
        visits and improve the site experience. We may also use essential
        browser storage for basic site functionality or preferences, such as
        remembering interface choices. CogniFocus does not sell your personal
        data, and we do not use third-party advertising cookies.
      </p>
    </section>

    <section class="privacy-card">
      <div class="privacy-card-header">
        <div class="privacy-icon" aria-hidden="true">&#128465;</div>
        <div>
          <h2>Data Retention And Deletion</h2>
          <p>
            CogniFocus keeps account, progress, support, and subscription status
            data while needed to operate the app, provide support, comply with
            platform requirements, or until deleted according to app controls
            and operational needs.
          </p>
        </div>
      </div>
      <p>
        You can delete your CogniFocus account from Settings. This removes
        synced profile and stats data that can be deleted from the client,
        clears local app data, and deletes the Firebase account.
      </p>
      <p>
        Deleting your CogniFocus account does not cancel a Google Play
        subscription. Subscriptions must be managed or cancelled through Google
        Play.
      </p>
      <p>
        Some purchase records may remain managed by Google Play and RevenueCat
        for subscription management, restore, fraud-prevention, tax, legal, or
        platform compliance purposes.
      </p>
    </section>

    <section class="privacy-card">
      <div class="privacy-card-header">
        <div class="privacy-icon" aria-hidden="true">&#9881;</div>
        <div>
          <h2>Your Controls</h2>
          <p>You can manage your permissions, account, and app data.</p>
        </div>
      </div>
      <ul class="privacy-list">
        <li>Revoke optional permissions in device settings</li>
        <li>Stop using the app at any time</li>
        <li>Uninstall the app to remove local data</li>
        <li>Delete your account from Settings</li>
        <li>Contact support for access or deletion help</li>
      </ul>
    </section>

    <section class="privacy-card privacy-contact-card">
      <div class="privacy-card-header">
        <div class="privacy-icon" aria-hidden="true">&#128231;</div>
        <div>
          <h2>Contact</h2>
          <p>
            For privacy questions or support, use the support option in
            CogniFocus Settings.
          </p>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

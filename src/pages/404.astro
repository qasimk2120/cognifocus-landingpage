---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteIcon from "../components/shared/SiteIcon.astro";
import goblinAnnoyed from "../assets/characters/goblin/avatar/annoyed.png";

const title = "404 - Page Lost | CogniFocus";
const description = "The CogniFocus Goblin lost this page. Head back home, read the blog, or download the Android app.";
const canonical = "https://cognifocus.app/404.html";
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogTitle="The Goblin lost this page"
  ogDescription="You wandered into the distraction void. Let's get you back in focus."
  ogImageAlt="CogniFocus Goblin reaction"
  bodyClass="not-found-page cf-shell"
  footerProps={{ includePinterest: true }}
  showFeaturedStrip={false}
  robots="noindex, follow"
>
  <main class="not-found-main" id="main-content">
    <section class="not-found-hero" aria-labelledby="notFoundTitle">
      <div class="not-found-copy">
        <span class="not-found-kicker">404 / focus leak</span>
        <h1 id="notFoundTitle">404</h1>
        <p class="not-found-lede">The Goblin lost this page.</p>
        <p class="not-found-subcopy">
          You wandered into the distraction void. This route drifted out of focus.
        </p>

        <div class="not-found-actions" aria-label="404 page actions">
          <a class="btn btn-glow not-found-primary" href="/">
            <SiteIcon name="mdi:home-variant" aria-hidden="true" />
            <span>Back to home</span>
          </a>
          <a class="btn btn-secondary not-found-secondary" href="/blog/">
            <SiteIcon name="mdi:book-open-variant" aria-hidden="true" />
            <span>Read the blog</span>
          </a>
          <a class="btn btn-ghost not-found-download" href="/download.html">
            <SiteIcon name="simple-icons:googleplay" aria-hidden="true" />
            <span>Download</span>
          </a>
        </div>
      </div>

      <figure class="not-found-goblin" aria-label="Annoyed Goblin reaction">
        <div class="not-found-orbit" aria-hidden="true">
          <span class="not-found-dot not-found-dot-one"></span>
          <span class="not-found-dot not-found-dot-two"></span>
          <span class="not-found-dot not-found-dot-three"></span>
        </div>
        <Image
          src={goblinAnnoyed}
          alt="Annoyed CogniFocus Goblin"
          width="512"
          height="512"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
        <figcaption>route.exe stopped focusing</figcaption>
      </figure>
    </section>
  </main>

  <style>
    .not-found-main {
      position: relative;
      isolation: isolate;
      min-height: clamp(560px, 70vh, 760px);
      display: grid;
      align-items: center;
      overflow: hidden;
      padding: clamp(3rem, 7vw, 6.5rem) 0;
    }

    .not-found-main::before,
    .not-found-main::after {
      content: "";
      position: absolute;
      border-radius: 999px;
      pointer-events: none;
      filter: blur(6px);
      opacity: 0.55;
      z-index: -1;
    }

    .not-found-main::before {
      width: min(44vw, 520px);
      aspect-ratio: 1;
      left: max(-12vw, -150px);
      top: 8%;
      background: radial-gradient(circle, rgba(var(--cf-mint-rgb), 0.2), transparent 64%);
      animation: notFoundDrift 9s ease-in-out infinite;
    }

    .not-found-main::after {
      width: min(46vw, 560px);
      aspect-ratio: 1;
      right: max(-14vw, -170px);
      bottom: 4%;
      background: radial-gradient(circle, rgba(var(--cf-cyan-rgb), 0.18), transparent 66%);
      animation: notFoundDrift 11s ease-in-out infinite reverse;
    }

    .not-found-hero {
      width: min(calc(100vw - 48px), var(--cf-max-content));
      margin: 0 auto;
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(260px, 0.72fr);
      align-items: center;
      gap: clamp(2rem, 6vw, 5rem);
    }

    .not-found-copy {
      max-width: 680px;
    }

    .not-found-kicker {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      margin-bottom: 1rem;
      padding: 0.45rem 0.85rem;
      border: 1px solid rgba(var(--cf-cyan-rgb), 0.28);
      border-radius: 999px;
      background: rgba(var(--cf-cyan-rgb), 0.08);
      color: var(--cf-cyan);
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .not-found-copy h1 {
      margin: 0;
      color: var(--cf-text);
      font-size: clamp(6.25rem, 20vw, 14rem);
      font-weight: 800;
      line-height: 0.8;
      letter-spacing: 0;
      text-shadow:
        0 0 34px rgba(var(--cf-cyan-rgb), 0.24),
        0 18px 60px rgba(var(--cf-black-rgb), 0.35);
    }

    .not-found-lede {
      margin: 1.25rem 0 0;
      color: var(--cf-text);
      font-size: clamp(1.75rem, 4vw, 3rem);
      font-weight: 800;
      line-height: 1.05;
      text-wrap: balance;
    }

    .not-found-subcopy {
      max-width: 36rem;
      margin: 1rem 0 0;
      color: var(--cf-muted);
      font-size: clamp(1rem, 2vw, 1.18rem);
      line-height: 1.7;
      text-wrap: balance;
    }

    .not-found-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.85rem;
      margin-top: 2rem;
    }

    .not-found-actions .btn {
      min-height: 46px;
    }

    .not-found-actions svg {
      width: 1.1rem;
      height: 1.1rem;
    }

    .not-found-primary {
      color: var(--cf-black) !important;
    }

    .not-found-secondary {
      background: rgba(var(--cf-light-card-rgb), 0.04);
      border-color: rgba(var(--cf-cyan-rgb), 0.22);
      color: var(--cf-text);
    }

    .not-found-download {
      padding-inline: 1.15rem;
    }

    .not-found-goblin {
      position: relative;
      justify-self: center;
      display: grid;
      justify-items: center;
      width: min(100%, 360px);
      margin: 0;
      padding: clamp(1.2rem, 3vw, 1.7rem);
      border: 1px solid rgba(var(--cf-cyan-rgb), 0.16);
      border-radius: 26px;
      background:
        linear-gradient(145deg, rgba(var(--cf-surface2-rgb), 0.72), rgba(var(--cf-navy-rgb), 0.82)),
        radial-gradient(circle at 50% 18%, rgba(var(--cf-goblin-rgb), 0.18), transparent 48%);
      box-shadow:
        0 26px 70px rgba(var(--cf-black-rgb), 0.32),
        0 0 80px rgba(var(--cf-cyan-rgb), 0.12),
        inset 0 1px 0 rgba(var(--cf-light-card-rgb), 0.04);
      overflow: hidden;
      transform: rotate(1.5deg);
    }

    .not-found-goblin img {
      position: relative;
      z-index: 1;
      width: min(76vw, 260px);
      height: auto;
      filter: drop-shadow(0 22px 26px rgba(var(--cf-black-rgb), 0.34));
      animation: notFoundGoblinFloat 4.8s ease-in-out infinite;
    }

    .not-found-goblin figcaption {
      position: relative;
      z-index: 1;
      margin-top: 0.5rem;
      color: rgba(var(--cf-cyan-rgb), 0.86);
      font-size: 0.84rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .not-found-orbit {
      position: absolute;
      inset: 12%;
      border: 1px solid rgba(var(--cf-cyan-rgb), 0.16);
      border-radius: 999px;
      transform: rotate(-16deg) scaleX(1.18);
    }

    .not-found-orbit::before {
      content: "";
      position: absolute;
      inset: 18%;
      border: 1px solid rgba(var(--cf-mint-rgb), 0.18);
      border-radius: inherit;
      transform: rotate(34deg) scaleX(1.22);
    }

    .not-found-dot {
      position: absolute;
      width: 8px;
      height: 8px;
      border-radius: 999px;
      background: var(--cf-mint);
      box-shadow: 0 0 16px rgba(var(--cf-mint-rgb), 0.7);
      animation: notFoundDotPulse 2.7s ease-in-out infinite;
    }

    .not-found-dot-one {
      left: 14%;
      top: 34%;
    }

    .not-found-dot-two {
      right: 18%;
      top: 16%;
      animation-delay: -0.9s;
    }

    .not-found-dot-three {
      right: 24%;
      bottom: 18%;
      animation-delay: -1.8s;
    }

    @keyframes notFoundGoblinFloat {
      0%,
      100% {
        transform: translateY(0) rotate(-1deg);
      }
      50% {
        transform: translateY(-10px) rotate(1deg);
      }
    }

    @keyframes notFoundDrift {
      0%,
      100% {
        transform: translate3d(0, 0, 0) scale(1);
      }
      50% {
        transform: translate3d(18px, -12px, 0) scale(1.05);
      }
    }

    @keyframes notFoundDotPulse {
      0%,
      100% {
        opacity: 0.36;
        transform: scale(0.8);
      }
      50% {
        opacity: 0.9;
        transform: scale(1.15);
      }
    }

    :global(html[data-theme="light"]) .not-found-main::before,
    :global(html:not([data-theme])) .not-found-main::before {
      background: radial-gradient(circle, rgba(var(--cf-mint-rgb), 0.18), transparent 64%);
      opacity: 0.68;
    }

    :global(html[data-theme="light"]) .not-found-main::after,
    :global(html:not([data-theme])) .not-found-main::after {
      background: radial-gradient(circle, rgba(var(--cf-cobalt-rgb), 0.16), transparent 66%);
      opacity: 0.68;
    }

    :global(html[data-theme="light"]) .not-found-copy h1,
    :global(html:not([data-theme])) .not-found-copy h1,
    :global(html[data-theme="light"]) .not-found-lede,
    :global(html:not([data-theme])) .not-found-lede {
      color: var(--cf-light-text);
      text-shadow: 0 16px 44px rgba(var(--cf-light-shadow-rgb), 0.14);
    }

    :global(html[data-theme="light"]) .not-found-subcopy,
    :global(html:not([data-theme])) .not-found-subcopy {
      color: var(--cf-light-muted);
    }

    :global(html[data-theme="light"]) .not-found-kicker,
    :global(html:not([data-theme])) .not-found-kicker {
      color: var(--cf-light-accent);
      background: rgba(var(--cf-cyan-rgb), 0.08);
      border-color: rgba(var(--cf-cyan-rgb), 0.22);
    }

    :global(html[data-theme="light"]) .not-found-secondary,
    :global(html:not([data-theme])) .not-found-secondary,
    :global(html[data-theme="light"]) .not-found-download,
    :global(html:not([data-theme])) .not-found-download {
      background: rgba(var(--cf-light-card-rgb), 0.72);
      border-color: rgba(var(--cf-cyan-rgb), 0.22);
      color: var(--cf-light-text);
    }

    :global(html[data-theme="light"]) .not-found-goblin,
    :global(html:not([data-theme])) .not-found-goblin {
      background:
        linear-gradient(145deg, rgba(var(--cf-light-card-rgb), 0.96), rgba(var(--cf-light-surface-rgb), 0.94)),
        radial-gradient(circle at 50% 18%, rgba(var(--cf-goblin-rgb), 0.14), transparent 48%);
      border-color: rgba(var(--cf-cyan-rgb), 0.2);
      box-shadow:
        0 22px 56px rgba(var(--cf-light-shadow-rgb), 0.14),
        0 0 60px rgba(var(--cf-cyan-rgb), 0.1),
        inset 0 1px 0 rgba(var(--cf-light-card-rgb), 0.7);
    }

    :global(html[data-theme="light"]) .not-found-goblin img,
    :global(html:not([data-theme])) .not-found-goblin img {
      filter: drop-shadow(0 18px 22px rgba(var(--cf-light-shadow-rgb), 0.18));
    }

    @media (max-width: 767.98px) {
      .not-found-main {
        min-height: auto;
        padding: 2.75rem 0 3.25rem;
      }

      .not-found-hero {
        width: calc(100vw - 24px);
        grid-template-columns: 1fr;
        text-align: center;
      }

      .not-found-copy {
        max-width: none;
      }

      .not-found-actions {
        justify-content: center;
      }

      .not-found-actions .btn {
        flex: 1 1 100%;
        max-width: 320px;
      }

      .not-found-goblin {
        width: min(100%, 310px);
        transform: none;
      }

      .not-found-goblin img {
        width: min(68vw, 220px);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .not-found-main::before,
      .not-found-main::after,
      .not-found-goblin img,
      .not-found-dot {
        animation: none !important;
      }
    }
  </style>
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import DemoVideo from "../components/shared/DemoVideo.astro";
import SiteIcon from "../components/shared/SiteIcon.astro";

const title = "CogniFocus Demo | Focus App That Reacts When You Lose Focus";
const description =
  "Watch how CogniFocus helps you stay focused with a focus timer, distraction Shield, and reactive Goblin companion.";
const canonical = "https://cognifocus.app/demo.html";
const pageTitle = "CogniFocus Demo";
const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": pageTitle,
    "headline": "See CogniFocus fight distractions in 34 seconds",
    "description": description,
    "url": canonical,
    "primaryImageOfPage": "https://cognifocus.app/assets/og/og-image.png",
    "mainEntity": {
      "@type": "VideoObject",
      "name": "How CogniFocus Helps You Stay Focused",
      "description": description,
      "thumbnailUrl": "https://cognifocus.app/images/cognifocus-focus-app-demo-poster.webp",
      "uploadDate": "2026-05-24T00:00:00Z",
      "contentUrl": "https://cognifocus.app/videos/cognifocus-focus-app-demo.mp4",
      "embedUrl": "https://cognifocus.app/demo",
      "publisher": {
        "@type": "Organization",
        "name": "CogniFocus",
        "url": "https://cognifocus.app/"
      }
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "CogniFocus",
    "operatingSystem": "Android",
    "applicationCategory": "ProductivityApplication",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "description": "A focus timer and app blocker for Android with Goblin reactions, Shield blocking, and recovery nudges.",
    "url": "https://cognifocus.app/",
    "downloadUrl": "https://play.google.com/store/apps/details?id=io.ionic.cognifocus",
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "5",
      "bestRating": "5",
      "worstRating": "1",
      "ratingCount": "5"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://cognifocus.app/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": pageTitle,
        "item": canonical
      }
    ]
  }
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogTitle={title}
  ogDescription={description}
  ogImageAlt="CogniFocus demo video"
  bodyClass="demo-page cf-shell"
  footerProps={{ includePinterest: true }}
>
  {
    schemas.map((schema) => (
      <script
        slot="head"
        type="application/ld+json"
        set:html={JSON.stringify(schema, null, 2)}
      />
    ))
  }

  <main id="main-content" class="demo-main">
    <header class="demo-hero">
      <h1 class="hero-heading demo-hero-heading">
        <span class="hero-heading-line">See CogniFocus fight</span>
        <span class="hero-heading-line hero-heading-accent"
          >distractions in 34 seconds</span
        >
      </h1>
    </header>

    <section class="demo-video-card" aria-label="How CogniFocus Helps You Stay Focused">
      <DemoVideo controls={true} autoplay={true} loop={false} muted={false} />
    </section>

    <div class="demo-actions hero-cta" aria-label="Demo page actions">
      <a
        href="https://play.google.com/store/apps/details?id=io.ionic.cognifocus"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-glow btn-lg me-1 primary-cta"
        data-keep-label="true"
      >
        <span class="cta-playstore-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" role="img" focusable="false">
            <path
              fill="#00d26a"
              d="M3.3 2.5L14.7 14 3.3 21.5c-.4-.2-.6-.6-.6-1V4c0-.4.2-.8.6-1z"
            />
            <path
              fill="#00a0ff"
              d="M18.4 11.5l-3.7-2.1L10.9 12l3.8 2.6 3.7-2.1c.8-.4.8-1.4 0-1.9z"
            />
            <path
              fill="#ffe000"
              d="M3.3 2.5l11.4 11.5 3.7-2.1L6.8 5.3 3.3 2.5z"
            />
            <path
              fill="#ff4f5e"
              d="M3.3 21.5l3.5-2.8 11.6-6.8-3.7-2.1L3.3 21.5z"
            />
          </svg>
        </span>
        <span class="cta-label">Start Free on Android</span>
      </a>
      <a
        href="/ios-waitlist.html"
        class="btn hero-ios-waitlist"
        aria-label="Join the CogniFocus iOS waitlist"
      >
        <SiteIcon name="simple-icons:apple" aria-hidden="true" />
        <span>Join iOS waitlist</span>
      </a>
    </div>
  </main>
</BaseLayout>

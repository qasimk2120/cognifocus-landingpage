---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArcadeDemoEmbed from "../components/shared/ArcadeDemoEmbed.astro";
import SiteIcon from "../components/shared/SiteIcon.astro";

const title = "CogniFocus Demo | Focus App That Reacts When You Lose Focus";
const description =
  "Watch how CogniFocus helps you stay focused with a focus timer, distraction Shield, and reactive Goblin companion.";
const canonical = "https://cognifocus.app/demo.html";
const pageTitle = "CogniFocus Demo";
const embedUrl =
  "https://demo.arcade.software/video/vV46cmtBx0HcXD74cEL4?embed&embed_mobile=inline&embed_desktop=inline&show_copy_link=true";
const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": pageTitle,
    "headline": "See CogniFocus fight distractions in 34 seconds",
    "description": description,
    "url": canonical,
    "primaryImageOfPage": "https://cognifocus.app/assets/og/og-image.png",
    "mainEntity": {
      "@type": "VideoObject",
      "name": "How CogniFocus Helps You Stay Focused",
      "description": description,
      "embedUrl": embedUrl,
      "duration": "PT34S",
      "publisher": {
        "@type": "Organization",
        "name": "CogniFocus",
        "url": "https://cognifocus.app/"
      }
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "CogniFocus",
    "operatingSystem": "Android",
    "applicationCategory": "ProductivityApplication",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "description": "A focus timer and app blocker for Android with Goblin reactions, Shield blocking, and recovery nudges.",
    "url": "https://cognifocus.app/",
    "downloadUrl": "https://play.google.com/store/apps/details?id=io.ionic.cognifocus"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://cognifocus.app/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": pageTitle,
        "item": canonical
      }
    ]
  }
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogTitle={title}
  ogDescription={description}
  ogImageAlt="CogniFocus demo video"
  bodyClass="demo-page cf-shell"
  footerProps={{ includePinterest: true }}
>
  {
    schemas.map((schema) => (
      <script
        slot="head"
        type="application/ld+json"
        set:html={JSON.stringify(schema, null, 2)}
      />
    ))
  }

  <main id="main-content" class="demo-main">
    <header class="demo-hero">
      <p class="feature-kicker">{pageTitle}</p>
      <h1>See CogniFocus fight distractions in 34 seconds</h1>
      <p>
        A quick walkthrough of the focus timer, Shield interruption, Goblin
        reaction, and recovery loop.
      </p>
    </header>

    <section class="demo-video-card" aria-label="How CogniFocus Helps You Stay Focused">
      <ArcadeDemoEmbed />
    </section>

    <div class="demo-actions" aria-label="Demo page actions">
      <a href="/download.html" class="btn btn-glow btn-lg primary-cta">
        Get CogniFocus
      </a>
      <a href="/ios-waitlist.html" class="btn btn-secondary">
        <SiteIcon name="simple-icons:apple" aria-hidden="true" />
        <span>Join iOS Waitlist</span>
      </a>
      <a href="/" class="btn btn-secondary">
        Back to home
      </a>
    </div>
  </main>
</BaseLayout>

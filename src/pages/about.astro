---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "About CogniFocus | Built by Qasim Khan, CogniElevate";
const description =
  "CogniFocus is a focus timer and app blocker for Android built by Qasim Khan, founder of CogniElevate. Here is why it was built and what it does.";
const canonical = "https://cognifocus.app/about.html";

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Qasim Khan",
  jobTitle: "Founder",
  worksFor: {
    "@type": "Organization",
    name: "CogniElevate",
    url: "https://cognielevate.co",
  },
  url: "https://cognifocus.app/about.html",
  email: "hello@cognifocus.app",
  sameAs: [
    "https://x.com/iqasim_explores",
  ],
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "CogniFocus",
  url: "https://cognifocus.app",
  logo: "https://cognifocus.app/assets/logo/text-logo.png",
  contactPoint: {
    "@type": "ContactPoint",
    email: "hello@cognifocus.app",
    contactType: "customer support",
  },
  sameAs: [
    "https://x.com/iqasim_explores",
    "https://www.instagram.com/cognifocus.app/",
    "https://www.tiktok.com/@cognifocus.app",
    "https://www.facebook.com/share/1Am7kCzkjG/",
    "https://www.pinterest.com/getcognifocus/",
    "https://www.producthunt.com/products/cognifocus",
  ],
};

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "CogniFocus",
  operatingSystem: "Android",
  applicationCategory: "ProductivityApplication",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
  description:
    "A focus timer and app blocker for Android with Goblin reactions, Shield blocking, recovery nudges, and an iOS waitlist for iPhone updates.",
  url: "https://cognifocus.app",
  downloadUrl:
    "https://play.google.com/store/apps/details?id=io.ionic.cognifocus",
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "5",
    bestRating: "5",
    worstRating: "1",
    ratingCount: "6",
  },
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogTitle={title}
  ogDescription={description}
  ogType="website"
  ogImageAlt="About CogniFocus"
  bodyClass="about-page cf-shell"
  footerProps={{ includePinterest: true }}
>
  <meta slot="head-after-robots" name="author" content="Qasim Khan" />
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(personSchema, null, 2)}
  />
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(organizationSchema, null, 2)}
  />
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(softwareSchema, null, 2)}
  />

  <main id="main-content" class="about-main">
    <header class="about-hero">
      <h1>Why CogniFocus exists</h1>
      <p>
        I kept losing focus sessions to &ldquo;just one quick check.&rdquo; The timer would keep running. The session would show as completed. But I had spent 20 minutes on TikTok. Most focus apps time you. They do not react to you. CogniFocus was built to close that gap.
      </p>
    </header>

    <div class="about-content" aria-label="CogniFocus product facts">
      <section class="about-card" aria-labelledby="about-platform">
        <h2 id="about-platform">Platform availability</h2>
        <ul>
          <li>Currently available on Android via Google Play and free to download.</li>
          <li>
            iOS version in development.
            <a href="/ios-waitlist.html">Join the iOS waitlist</a>.
          </li>
          <li>Desktop support is being explored for a later phase.</li>
        </ul>
      </section>

      <section class="about-card" aria-labelledby="about-how-it-works">
        <h2 id="about-how-it-works">How it works</h2>
        <p>
          The user starts a focus session with a chosen duration. Distraction
          Shield monitors for blocked apps during the session. When a blocked
          app is opened, the Shield interrupts it.
        </p>
        <p>
          The Goblin companion reacts with mood-based responses: neutral during
          calm sessions, annoyed or angry when distractions occur, and cheerful
          when sessions are completed cleanly. Streaks, XP, and daily goals
          track progress over time. Recovery nudges help the user return to
          focus after a distraction rather than abandoning the session.
        </p>
      </section>

      <section class="about-card" aria-labelledby="about-audience">
        <h2 id="about-audience">Who it is for</h2>
        <ul>
          <li>Students who lose focus during study sessions.</li>
          <li>People with ADHD-style distraction patterns.</li>
          <li>Anyone who relies on passive timers that they ignore.</li>
          <li>People who keep opening social apps out of habit during work.</li>
        </ul>
      </section>

      <section class="about-card" aria-labelledby="about-features">
        <h2 id="about-features">Key features</h2>
        <ul class="about-feature-list">
          <li>Focus timer with preset and custom session durations.</li>
          <li>Distraction Shield - blocks selected apps during active sessions.</li>
          <li>Goblin companion with real-time mood reactions.</li>
          <li>Mood states: neutral, annoyed, angry, cheerful.</li>
          <li>Character affinity system - Goblin adapts over time.</li>
          <li>Streaks, XP, and daily focus goals.</li>
          <li>Recovery nudges when focus slips mid-session.</li>
          <li>Planned Sessions with reminders (Pro).</li>
          <li>Cloud sync and full restore across devices (Pro).</li>
          <li>Android foreground service showing live session time.</li>
        </ul>
      </section>

      <section class="about-card" aria-labelledby="about-pricing">
        <h2 id="about-pricing">Pricing</h2>
        <p>
          Free plan available. Pro plan unlocks advanced features including
          longer sessions, more blocked apps, planned sessions, recovery
          nudges, and cloud sync.
        </p>
        <a class="about-text-link" href="/pricing.html">See full pricing &rarr;</a>
      </section>

      <section class="about-card" aria-labelledby="about-built-by">
        <h2 id="about-built-by">Built by</h2>
        <p>
          I&rsquo;m Qasim Khan, founder of <a href="https://cognielevate.co" target="_blank" rel="noopener noreferrer">CogniElevate</a>. I built CogniFocus because I needed it. Passive reminders do not work for me. I needed something that would notice when I slipped and say something about it. The Goblin is that thing.
        </p>
        <p>CogniElevate (SMC-Private) Limited is based in Lahore, Pakistan.</p>
        <dl class="about-facts">
          <div>
            <dt>Contact</dt>
            <dd><a href="mailto:hello@cognifocus.app">hello@cognifocus.app</a></dd>
          </div>
          <div>
            <dt>Support</dt>
            <dd><a href="/support.html">Support page</a></dd>
          </div>
          <div>
            <dt>Press enquiries</dt>
            <dd><a href="mailto:press@cognifocus.app">press@cognifocus.app</a></dd>
          </div>
        </dl>
      </section>

      <section class="about-card" aria-labelledby="about-launch">
        <h2 id="about-launch">Launch and availability</h2>
        <dl class="about-facts">
          <div>
            <dt>Launched</dt>
            <dd>2026</dd>
          </div>
          <div>
            <dt>Available on</dt>
            <dd>Android (Google Play)</dd>
          </div>
          <div>
            <dt>iOS</dt>
            <dd>In development, waitlist open</dd>
          </div>
          <div>
            <dt>Desktop</dt>
            <dd>Future support being explored</dd>
          </div>
          <div>
            <dt>Current
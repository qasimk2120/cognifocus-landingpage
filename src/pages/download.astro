---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import SiteIcon from "../components/shared/SiteIcon.astro";
import appLogo from "../assets/logo/app-logo.png";

const title = "Download CogniFocus for Android";
const description = "Download CogniFocus for Android. Start your first focus session free — the Goblin is waiting.";
const canonical = "https://cognifocus.app/download.html";
const ogTitle = "Download CogniFocus";
const ogDescription = "The Goblin is waiting. Start your first focus session free on Android.";
const schemaJson = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "CogniFocus",
  "operatingSystem": "Android",
  "applicationCategory": "ProductivityApplication",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "description": "A focus timer and app blocker that sends a Goblin after you the second you drift to TikTok, Instagram, or YouTube.",
  "url": "https://cognifocus.app",
  "downloadUrl": "https://play.google.com/store/apps/details?id=io.ionic.cognifocus"
}, null, 2);
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  ogImageAlt="CogniFocus"
  includeOgImageAlt={false}
  includeTwitterImageAlt={false}
  bodyClass="download-page cf-shell"
  footerProps={{ includePinterest: true }}
  featuredStripProps={{ yoDirectoryInlineStyle: true }}
>
  <link slot="head-after-social" href="https://fonts.googleapis.com/css2?family=Funnel+Display:wght@400..800&family=Funnel+Sans:wght@300..800&display=swap" rel="stylesheet" />
  <script slot="head" type="application/ld+json" set:html={schemaJson} />

  <main>
      <header class="container text-center download-hero">
        <span class="feature-kicker">
          Android Download <span aria-hidden="true">&#9889;</span>
        </span>

        <h1>
          Download CogniFocus for
          <span class="hero-heading-line hero-heading-accent">Android</span>
        </h1>

        <p class="hero-muted-override download-subtitle">
          The Goblin is waiting.
        </p>
      </header>

      <section class="download-main">
        <article class="download-card download-card-highlight text-center">
          <div class="download-logo-wrap" aria-hidden="true">
            <Image
              src={appLogo}
              class="download-logo"
              alt="CogniFocus app logo"
              width="569"
              height="438"
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
          </div>

          <h2 id="platformTitle">Open on Google Play</h2>

          <p id="redirectStatus" class="download-status" aria-live="polite">
            Android focus app with distraction blocking + Goblin reactions.
          </p>
          <div class="download-cta-group">
            <a
              id="playStoreCta"
              href="https://play.google.com/store/apps/details?id=io.ionic.cognifocus"
              class="btn btn-glow play-store-btn"
              target="_blank"
              rel="noopener noreferrer"
              hidden
            >
              <span class="download-cta__icon" data-download-playstore-icon aria-hidden="true">
                <SiteIcon name="simple-icons:googleplay" aria-hidden="true" />
              </span>
              <span class="download-cta__icon" data-download-apple-icon aria-hidden="true" hidden>
                <SiteIcon name="simple-icons:apple" aria-hidden="true" />
              </span>
              <span class="download-cta__label" data-download-cta-label>Open in Google Play</span>
              <span class="download-cta__icon" data-download-external-icon aria-hidden="true">
                <SiteIcon name="mdi:open-in-new" aria-hidden="true" />
              </span>
            </a>

            <p id="retryHint" class="download-note" hidden>
              If Instagram or another in-app browser blocks redirects, tap the
              button above.
            </p>
          </div>
        </article>

        <section
          class="download-ios-banner"
          aria-labelledby="downloadIosWaitlistTitle"
        >
          <div class="download-ios-banner__copy">
            <span class="download-ios-banner__eyebrow">
              <SiteIcon name="simple-icons:apple" aria-hidden="true" />
              iOS coming next
            </span>
            <h2 id="downloadIosWaitlistTitle">Want CogniFocus on iPhone?</h2>
            <p>
              Join the iOS waitlist and we'll let you know when it drops.
            </p>
          </div>

          <div class="download-ios-banner__cta">
            <a
              href="/ios-waitlist.html"
              class="btn btn-secondary download-ios-cta"
            >
              <SiteIcon name="simple-icons:apple" aria-hidden="true" />
              <span>Join the iOS Waitlist</span>
            </a>
          </div>
        </section>
      </section>
      <article class="download-card download-info-card download-compact-note">
        <div class="download-card-header">
          <div class="download-icon" aria-hidden="true">&#128241;</div>
          <div>
            <h2>Android only for now</h2>
            <p>iOS waitlist is open.</p>
          </div>
        </div>
      </article>
    </main>
  
</BaseLayout>



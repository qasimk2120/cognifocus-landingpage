---
import BlogListLayout from "../../../components/blog/BlogListLayout.astro";
import {
  BLOG_PAGE_SIZE,
  getBlogPagePath,
  getSortedPosts,
} from "../../../utils/blog";

export function getStaticPaths({ paginate }) {
  return paginate(getSortedPosts(), { pageSize: BLOG_PAGE_SIZE }).filter(
    ({ params }) => Number(params.page) > 1,
  );
}

const { page } = Astro.props;
const pageNumber = page.currentPage;
const title = `CogniFocus Blog | Page ${pageNumber}`;
const description = "More CogniFocus guides about focus sessions, app blocking, distraction recovery, and building a healthier Android routine.";
const canonical = `https://cognifocus.app${getBlogPagePath(pageNumber)}`;
const previousHref = getBlogPagePath(pageNumber - 1);
const nextHref = pageNumber < page.lastPage ? getBlogPagePath(pageNumber + 1) : undefined;
---

<BlogListLayout
  posts={page.data}
  title={title}
  description={description}
  canonical={canonical}
  ogTitle={title}
  ogDescription={description}
  eyebrow="CogniFocus Blog"
  heading="Focus Guides"
  headingAccent={`Page ${pageNumber}`}
  intro="More practical guides for protecting focus sessions, blocking distracting apps, and recovering faster when attention slips."
  breadcrumbLabel={`Blog Page ${pageNumber}`}
  previousHref={previousHref}
  nextHref={nextHref}
/>

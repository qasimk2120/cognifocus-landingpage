---
import BlogListLayout from "../../../components/blog/BlogListLayout.astro";
import {
  BLOG_PAGE_SIZE,
  getBlogPagePath,
  getSortedPosts,
} from "../../../utils/blog";

export async function getStaticPaths({ paginate }) {
  return paginate(await getSortedPosts(), { pageSize: BLOG_PAGE_SIZE }).filter(
    ({ params }) => Number(params.page) > 1,
  );
}

const { page } = Astro.props;
const pageNumber = page.currentPage;
const title = `CogniFocus Blog - Page ${pageNumber}`;
const description = `Page ${pageNumber} of CogniFocus guides on focus sessions, app blocking, ADHD-friendly productivity, and beating doomscrolling on Android.`;
const canonical = `https://cognifocus.app${getBlogPagePath(pageNumber)}`;
---

<BlogListLayout
  posts={page.data}
  title={title}
  description={description}
  canonical={canonical}
  ogTitle={title}
  ogDescription={description}
  eyebrow="CogniFocus Blog"
  heading="CogniFocus Blog"
  headingAccent=""
  intro="More practical guides for protecting focus sessions, blocking distracting apps, and recovering faster when attention slips."
  breadcrumbLabel="Blog"
  pageContext={`Page ${page.currentPage} of ${page.lastPage}`}
  page={page}
  basePath="/blog"
  pageSize={BLOG_PAGE_SIZE}
  robots="noindex, follow"
/>

---
import BlogPostLayout from "../../components/blog/BlogPostLayout.astro";
import { getPostBySlug } from "../../utils/blog.js";

const post = await getPostBySlug("app-blocker-for-studying");

if (!post) {
  throw new Error("Missing blog post content for app-blocker-for-studying");
}
---

<BlogPostLayout post={post} />

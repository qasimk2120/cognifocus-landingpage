---
import BlogPostLayout from "../../components/blog/BlogPostLayout.astro";
import posts from "../../data/blog/posts.json";

const post = posts.find((entry) => entry.slug === "app-blocker-for-studying");

if (!post) {
  throw new Error("Missing blog post data for app-blocker-for-studying");
}
---

<BlogPostLayout post={post} />

---
import BlogPostLayout from "../../components/blog/BlogPostLayout.astro";
import { getPostBySlug } from "../../utils/blog.js";

const post = await getPostBySlug("cognifocus-vs-appblock");

if (!post) {
  throw new Error("Missing blog post content for cognifocus-vs-appblock");
}
---

<BlogPostLayout post={post} />

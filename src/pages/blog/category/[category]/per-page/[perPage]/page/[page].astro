---
import BlogListLayout from "../../../../../../../components/blog/BlogListLayout.astro";
import {
  BLOG_PAGE_SIZE,
  BLOG_PAGE_SIZE_OPTIONS,
  getActiveCategories,
  getCategoryPagePath,
  getPageSlice,
  getPostsByCategory,
  getTotalPages,
  normalizeBlogPageSize,
} from "../../../../../../../utils/blog";

export async function getStaticPaths() {
  const categories = await getActiveCategories();
  const pageSizePaths = BLOG_PAGE_SIZE_OPTIONS.filter((size) => size !== BLOG_PAGE_SIZE);
  const paths = await Promise.all(
    categories.map(async (category) => {
      const posts = await getPostsByCategory(category.slug);

      return pageSizePaths.flatMap((pageSize) => {
        const lastPage = getTotalPages(posts, pageSize);

        return Array.from({ length: Math.max(0, lastPage - 1) }, (_, index) => {
          const pageNumber = index + 2;

          return {
            params: {
              category: category.slug,
              perPage: String(pageSize),
              page: String(pageNumber),
            },
            props: { category, pageSize, pageNumber },
          };
        });
      });
    }),
  );

  return paths.flat();
}

const { category } = Astro.props;
const pageSize = normalizeBlogPageSize(Astro.props.pageSize);
const pageNumber = Number(Astro.props.pageNumber || 1);
const posts = await getPostsByCategory(category.slug);
const title = `${category.label} | CogniFocus Blog - Page ${pageNumber}`;
const description = `More CogniFocus ${category.label.toLowerCase()} articles shown ${pageSize} posts per page, covering focus sessions, app blocking, and Android focus habits.`;
const canonical = `https://cognifocus.app${getCategoryPagePath(category.slug, pageNumber, pageSize)}`;
const page = {
  currentPage: pageNumber,
  lastPage: getTotalPages(posts, pageSize),
};
---

<BlogListLayout
  posts={getPageSlice(posts, pageNumber, pageSize)}
  title={title}
  description={description}
  canonical={canonical}
  ogTitle={title}
  ogDescription={description}
  eyebrow="CogniFocus Blog"
  heading={category.label}
  headingAccent=""
  intro="More posts from this CogniFocus category, collected for readers who want practical focus and app-blocking guidance."
  activeCategorySlug={category.slug}
  breadcrumbLabel={category.label}
  pageContext={`Page ${page.currentPage} of ${page.lastPage}`}
  page={page}
  basePath={`/blog/category/${category.slug}/per-page/${pageSize}`}
  pageSize={pageSize}
  robots="noindex, follow"
/>

---
import BlogListLayout from "../../../../../components/blog/BlogListLayout.astro";
import {
  BLOG_PAGE_SIZE,
  getActiveCategories,
  getCategoryPagePath,
  getPostsByCategory,
} from "../../../../../utils/blog";

export async function getStaticPaths({ paginate }) {
  const categoryPaths = await Promise.all(
    (await getActiveCategories()).map(async (category) =>
      paginate(await getPostsByCategory(category.slug), {
        pageSize: BLOG_PAGE_SIZE,
        params: { category: category.slug },
        props: { category },
      }).filter(({ params }) => Number(params.page) > 1),
    ),
  );

  return categoryPaths.flat();
}

const { category, page } = Astro.props;
const pageNumber = page.currentPage;
const title = `${category.label} | CogniFocus Blog`;
const description = `More CogniFocus ${category.label.toLowerCase()} articles about focus sessions, app blocking, distraction recovery, and Android focus habits.`;
const canonical = `https://cognifocus.app${getCategoryPagePath(category.slug, pageNumber)}`;
---

<BlogListLayout
  posts={page.data}
  title={title}
  description={description}
  canonical={canonical}
  ogTitle={title}
  ogDescription={description}
  eyebrow="CogniFocus Blog"
  heading={category.label}
  headingAccent=""
  intro="More posts from this CogniFocus category, collected for readers who want practical focus and app-blocking guidance."
  activeCategorySlug={category.slug}
  breadcrumbLabel={category.label}
  pageContext={`Page ${page.currentPage} of ${page.lastPage}`}
  page={page}
  basePath={`/blog/category/${category.slug}`}
/>

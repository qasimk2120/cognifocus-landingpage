---
import BlogPostLayout from "../../components/blog/BlogPostLayout.astro";
import posts from "../../data/blog/posts.json";

const post = posts.find((entry) => entry.slug === "best-focus-apps-for-adhd");

if (!post) {
  throw new Error("Missing blog post data for best-focus-apps-for-adhd");
}
---

<BlogPostLayout post={post} />

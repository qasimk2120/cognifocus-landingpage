---
import BlogListLayout from "../../../components/blog/BlogListLayout.astro";
import {
  BLOG_PAGE_SIZE,
  getBlogPagePath,
  getPageSlice,
  getTotalPages,
  getSortedPosts,
} from "../../../utils/blog";

const title = "CogniFocus Blog | Focus Guides and Productivity Articles";
const description = "CogniFocus is a focus timer and app blocker where a Goblin reacts the moment you drift into TikTok, Instagram, or YouTube. Actionable guides to protect deep work.";
const canonical = "https://cognifocus.app/blog/";
const ogTitle = "CogniFocus Blog | Focus Guides and Productivity Articles";
const ogDescription = "CogniFocus pairs a focus timer and app blocker with a Goblin that reacts the moment you drift into TikTok, Instagram, or YouTube.";
const sortedPosts = await getSortedPosts();
const pagePosts = getPageSlice(sortedPosts, 1, BLOG_PAGE_SIZE);
const page = {
  currentPage: 1,
  lastPage: getTotalPages(sortedPosts, BLOG_PAGE_SIZE),
  url: {
    prev: undefined,
    next: sortedPosts.length > BLOG_PAGE_SIZE ? getBlogPagePath(2) : undefined,
  },
};
---

<BlogListLayout
  posts={pagePosts}
  title={title}
  description={description}
  canonical={canonical}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  page={page}
  basePath="/blog"
/>

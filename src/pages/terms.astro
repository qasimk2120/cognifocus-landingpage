---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteIcon from "../components/shared/SiteIcon.astro";

const title = "Terms of Service | CogniFocus";
const description =
  "Read the CogniFocus Terms of Service for website forms, app use, permissions, Shield behavior, subscriptions, support, acceptable use, availability, and liability.";
const canonical = "https://cognifocus.app/terms.html";
const termsSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Terms of Service",
  url: canonical,
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImageAlt="CogniFocus terms page"
  includeTwitterImageAlt={false}
  bodyClass="terms-page policy-usage cf-shell"
  footerProps={{ includePinterest: true }}
  featuredStripProps={{ yoDirectoryInlineStyle: true }}
>
  <meta slot="head-after-robots" name="author" content="CogniElevate" />
  <meta slot="head-after-robots" name="application-name" content="CogniFocus" />
  <link slot="head-after-social" rel="preconnect" href="https://fonts.googleapis.com" />
  <link slot="head-after-social" rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    slot="head-after-social"
    href="https://fonts.googleapis.com/css2?family=Funnel+Display:wght@400..800&family=Funnel+Sans:wght@300..800&display=swap"
    rel="stylesheet"
  />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(termsSchema, null, 2)} />

  <main>
    <section class="container text-center legal-hero">

      <h1>
        Terms of <span class="hero-heading-line hero-heading-accent">Service</span>
      </h1>

      <p class="hero-muted-override legal-subtitle">
        <span class="policy-updated">Last updated: May 29, 2026</span>
        <span class="policy-summary">
          These Terms cover the CogniFocus website, public forms, and mobile
          app.
        </span>
      </p>
    </section>

    <section class="legal-main">
      <nav class="legal-toc page-jump-nav" aria-label="Terms sections">
        <a href="#using-cognifocus" class="page-jump-link">
            <span class="page-jump-icon" style="--page-jump-accent-rgb: var(--cf-mint-rgb);" aria-hidden="true"><SiteIcon name="mdi:check-all" aria-hidden="true" /></span>
          Using CogniFocus
        </a>
        <a href="#acceptable-use" class="page-jump-link">
            <span class="page-jump-icon" style="--page-jump-accent-rgb: var(--cf-amber-rgb);" aria-hidden="true"><SiteIcon name="mdi:shield-check-outline" aria-hidden="true" /></span>
          Acceptable Use
        </a>
        <a href="#shield-permissions" class="page-jump-link">
            <span class="page-jump-icon" style="--page-jump-accent-rgb: var(--cf-cyan-rgb);" aria-hidden="true"><SiteIcon name="mdi:shield-lock-outline" aria-hidden="true" /></span>
          Shield And Permissions
        </a>
        <a href="#premium" class="page-jump-link">
            <span class="page-jump-icon" style="--page-jump-accent-rgb: var(--cf-goblin-rgb);" aria-hidden="true"><SiteIcon name="mdi:credit-card-outline" aria-hidden="true" /></span>
          Premium
        </a>
        <a href="#availability" class="page-jump-link">
            <span class="page-jump-icon" style="--page-jump-accent-rgb: var(--cf-cyan-rgb);" aria-hidden="true"><SiteIcon name="mdi:wifi" aria-hidden="true" /></span>
          Availability
        </a>
        <a href="#support" class="page-jump-link">
            <span class="page-jump-icon" style="--page-jump-accent-rgb: var(--cf-mint-rgb);" aria-hidden="true"><SiteIcon name="mdi:chat-outline" aria-hidden="true" /></span>
          Support
        </a>
        <a href="#liability" class="page-jump-link">
            <span class="page-jump-icon" style="--page-jump-accent-rgb: var(--cf-amber-rgb);" aria-hidden="true"><SiteIcon name="mdi:alert-outline" aria-hidden="true" /></span>
          Liability
        </a>
        <a href="#governing-law" class="page-jump-link">
            <span class="page-jump-icon" style="--page-jump-accent-rgb: var(--cf-mint-rgb);" aria-hidden="true"><SiteIcon name="mdi:gavel" aria-hidden="true" /></span>
          Governing Law
        </a>
        <a href="#contact" class="page-jump-link">
            <span class="page-jump-icon" style="--page-jump-accent-rgb: var(--cf-cyan-rgb);" aria-hidden="true"><SiteIcon name="mdi:email-outline" aria-hidden="true" /></span>
          Contact
        </a>
      </nav>
      <div class="policy-pill-divider page-jump-divider" aria-hidden="true">
        <span></span>
      </div>

      <article class="legal-card legal-card-highlight" id="using-cognifocus">
        <div class="legal-card-header">
          <div class="legal-icon" aria-hidden="true">&#9989;</div>
          <div>
            <h2>Using CogniFocus</h2>
            <p>
              CogniFocus provides focus timers, Shield/app-blocking features,
              planned sessions, reminders, progress tracking, character
              reactions, website pages, public forms, and premium features.
            </p>
          </div>
        </div>

        <ul class="legal-list">
          <li>You are responsible for how you use your device, permissions, and app settings.</li>
          <li>CogniFocus is a focus and productivity tool, not a medical, legal, financial, safety, or emergency service.</li>
          <li>Features may be adjusted, renamed, moved, limited, improved, or removed over time.</li>
        </ul>
      </article>

      <article class="legal-card" id="acceptable-use">
        <div class="legal-card-header">
          <div class="legal-icon" aria-hidden="true">&#128737;</div>
          <div>
            <h2>Acceptable Use</h2>
            <p>
              Use CogniFocus and its public forms responsibly. Please do not
              make the anti-distraction tool become the distraction.
            </p>
          </div>
        </div>

        <ul class="legal-list">
          <li>Do not spam, scrape, flood, or abuse waitlist, support, or contact forms.</li>
          <li>Do not submit misleading, harmful, unlawful, or abusive content.</li>
          <li>Do not attempt to bypass Shield, app blocking, Turnstile, rate limits, authentication, or other security systems.</li>
          <li>Do not interfere with Firebase, Cloud Functions, Firestore, analytics, subscription, or app-store systems.</li>
          <li>Do not use CogniFocus in a way that harms other users, the service, or third-party systems.</li>
        </ul>
      </article>

      <article class="legal-card" id="shield-permissions">
        <div class="legal-card-header">
          <div class="legal-icon" aria-hidden="true">&#128274;</div>
          <div>
            <h2>Shield And Permissions</h2>
            <p>
              Shield and app blocking depend on Android permissions and device
              behavior.
            </p>
          </div>
        </div>

        <p>
          Usage Access lets CogniFocus detect open apps so Shield can respond to
          distraction attempts. Overlay permission lets CogniFocus show blocking
          or recovery screens. Notifications support planned sessions and
          reminders.
        </p>
        <p>
          You can revoke permissions in Android settings. If you do, Shield,
          Manual Block, and reminders may stop working or behave differently.
          CogniFocus cannot guarantee that every device, Android version, or app
          will be blocked perfectly.
        </p>
      </article>

      <article class="legal-card" id="accounts-data">
        <div class="legal-card-header">
          <div class="legal-icon" aria-hidden="true">&#128273;</div>
          <div>
            <h2>Accounts And Data</h2>
            <p>
              CogniFocus may use anonymous Firebase accounts, cloud sync, local
              device storage, support records, and queued mail records to run
              the product.
            </p>
          </div>
        </div>

        <p>
          The Privacy Policy explains what website and app data may be stored
          locally or synced to the cloud. By using CogniFocus, you understand
          that not all app data is local-only.
        </p>
      </article>

      <article class="legal-card" id="premium">
        <div class="legal-card-header">
          <div class="legal-icon" aria-hidden="true">&#128179;</div>
          <div>
            <h2>Premium And Subscriptions</h2>
            <p>
              Premium access, subscriptions, trials, renewals, cancellations,
              and purchase restoration are handled through app stores and
              RevenueCat where applicable.
            </p>
          </div>
        </div>

        <ul class="legal-list">
          <li>Subscription terms may depend on Google Play, Apple App Store, or RevenueCat behavior.</li>
          <li>Manage or cancel subscriptions through the app store that processed the purchase.</li>
          <li>Deleting your CogniFocus account does not automatically cancel an app-store subscription.</li>
          <li>Premium features, pricing, trials, tiers, and availability may change.</li>
        </ul>
      </article>

      <article class="legal-card" id="availability">
        <div class="legal-card-header">
          <div class="legal-icon" aria-hidden="true">&#128246;</div>
          <div>
            <h2>Availability And Changes</h2>
            <p>
              CogniFocus may depend on your device, Android version, app-store
              availability, Firebase/Google Cloud, RevenueCat, Cloudflare,
              PostHog, and other platform services.
            </p>
          </div>
        </div>

        <p>
          We do not guarantee uninterrupted availability, perfect accuracy, or
          bug-free behavior. Beta, experimental, early-access, or upcoming
          features may change, pause, or disappear.
        </p>
        <p>
          Product availability may vary by platform, region, store approval,
          device compatibility, permissions, subscription status, and service
          provider behavior.
        </p>
      </article>

      <article class="legal-card" id="support">
        <div class="legal-card-header">
          <div class="legal-icon" aria-hidden="true">&#128172;</div>
          <div>
            <h2>Support And Contact</h2>
            <p>
              Support may be provided through in-app support, public website
              forms, email queues, or other listed channels.
            </p>
          </div>
        </div>

        <p>
          Support availability is not guaranteed. Requests may be rate-limited
          or blocked if they look abusive, automated, or unrelated to
          CogniFocus. Information submitted through support may be used to reply,
          troubleshoot, and improve reliability.
        </p>
      </article>

      <article class="legal-card" id="liability">
        <div class="legal-card-header">
          <div class="legal-icon" aria-hidden="true">&#9888;</div>
          <div>
            <h2>Limitation Of Liability</h2>
            <p>
              To the maximum extent permitted by law, CogniFocus is provided as
              is and at your own discretion and risk.
            </p>
          </div>
        </div>

        <p>
          CogniFocus is not liable for indirect, incidental, special,
          consequential, or punitive losses. This includes lost productivity,
          missed reminders, missed sessions, app-blocking gaps, permission
          issues, subscription platform issues, data loss, service interruptions,
          or third-party provider behavior.
        </p>
      </article>

      <article class="legal-card" id="data-deletion">
        <div class="legal-card-header">
          <div class="legal-icon" aria-hidden="true">&#128465;</div>
          <div>
            <h2>Deletion Requests</h2>
            <p>
              You can request deletion or use deletion controls where available.
            </p>
          </div>
        </div>

        <p>
          Some records may remain where needed for subscription restore,
          security, abuse prevention, platform requirements, tax, legal, or
          operational reasons. App-store subscriptions must be cancelled through
          the relevant store.
        </p>
      </article>

      <article class="legal-card" id="governing-law">
        <div class="legal-card-header">
          <div class="legal-icon" aria-hidden="true">&#9878;</div>
          <div>
            <h2>Governing Law And User Rights</h2>
            <p>
              These Terms are governed by applicable law. If mandatory consumer
              protection laws in your jurisdiction provide you with additional
              rights, those rights are not waived by these Terms.
            </p>
          </div>
        </div>

        <p>
          <strong>EU / EEA users.</strong> If you are located in the European
          Union or European Economic Area, you have rights under the GDPR
          including access, rectification, erasure, portability, and the right
          to lodge a complaint with a supervisory authority. See the
          <a href="/privacy.html#gdpr">GDPR section of our Privacy Policy</a>
          for details.
        </p>
        <p>
          <strong>California users.</strong> If you are a California resident,
          you have rights under the CCPA including the right to know, delete,
          and opt out of sale (note: we do not sell personal information). See
          the <a href="/privacy.html#ccpa">California Privacy Rights section of our Privacy Policy</a>
          for details.
        </p>
        <p>
          To exercise any legal rights or submit a privacy request, email
          <a href="mailto:hello@cognifocus.app">hello@cognifocus.app</a>.
        </p>
      </article>

      <article class="legal-card" id="contact">
        <div class="legal-card-header">
          <div class="legal-icon" aria-hidden="true">&#128231;</div>
          <div>
            <h2>Contact</h2>
            <p>
              For questions, support, account, or privacy requests (including
              GDPR and CCPA), use the
              <a href="/support.html">support page</a>, the support option in
              CogniFocus Settings, or email
              <a href="mailto:hello@cognifocus.app">hello@cognifocus.app</a>.
            </p>
          </div>
        </div>
      </article>
    </section>
  </main>
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "CogniFocus Pricing | Pro Monthly and Yearly Plans";
const description = "Compare CogniFocus pricing. Start with the free focus companion, try Pro monthly for $3.99 after a 7-day trial or choose yearly Pro for $31.99";
const canonical = "https://cognifocus.app/pricing.html";
const ogTitle = "CogniFocus Pricing";
const ogDescription = "Compare Free, Pro Monthly, and Pro Yearly plans for CogniFocus.";
const schemaJson = "{\n        \"@context\": \"https://schema.org\",\n        \"@type\": \"SoftwareApplication\",\n        \"name\": \"CogniFocus\",\n        \"applicationCategory\": \"ProductivityApplication\",\n        \"operatingSystem\": \"Android\",\n        \"url\": \"https://cognifocus.app/pricing.html\",\n        \"installUrl\": \"https://play.google.com/store/apps/details?id=io.ionic.cognifocus\",\n        \"offers\": [\n          {\n            \"@type\": \"Offer\",\n            \"name\": \"CogniFocus Free\",\n            \"price\": \"0\",\n            \"priceCurrency\": \"USD\",\n            \"category\": \"Free\"\n          },\n          {\n            \"@type\": \"Offer\",\n            \"name\": \"CogniFocus Pro Monthly\",\n            \"price\": \"3.99\",\n            \"priceCurrency\": \"USD\",\n            \"category\": \"Subscription\",\n            \"description\": \"Monthly CogniFocus Pro subscription with a 7-day trial\"\n          },\n          {\n            \"@type\": \"Offer\",\n            \"name\": \"CogniFocus Pro Yearly\",\n            \"price\": \"31.99\",\n            \"priceCurrency\": \"USD\",\n            \"category\": \"Subscription\",\n            \"description\": \"Yearly CogniFocus Pro subscription without a trial\"\n          }\n        ]\n      }";
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  ogImageAlt="CogniFocus pricing for a focus companion and distraction blocker"
  includeOgSiteName={false}
  twitterAttribute="property"
  includeTwitterImageAlt={false}
  bodyClass="pricing-page cf-shell"
  bootstrapIconsFirst={true}
  footerProps={{ includePinterest: true, faqHref: "#faq" }}
  featuredStripProps={{ yoDirectoryInlineStyle: true }}
>
  <script slot="head" type="application/ld+json" set:html={schemaJson} />
  <main class="container py-5">
      <header class="text-center pricing-page-hero">
        <span class="feature-kicker">
          Pricing <span aria-hidden="true">&#128176;</span>
        </span>
        <h1>
          CogniFocus
          <span class="hero-heading-line hero-heading-accent">Pricing</span>
        </h1>
        <p class="hero-muted-override mb-0">
          Start free, then upgrade when you want stronger Shield protection,
          planned sessions, and recovery support
        </p>
      </header>

      <section class="pricing-panel mx-auto">
        <div class="pricing-grid">
          <article class="pricing-card">
              <div class="pricing-card-top">
                <span class="pricing-label">Basic</span>
                <h2>Free</h2>
                <p class="pricing-price">$0</p>
                <p class="pricing-note">
                  For starting focus with the companion
                </p>
              </div>
              <ul class="pricing-list">
                <li>Core focus sessions and countdown controls</li>
                <li>Goblin mood and reaction moments</li>
                <li>Daily goal and progress foundations</li>
                <li>Starter Shield protection</li>
              </ul>
              <a href="download.html" class="pricing-link">Get started</a>
              <p class="pricing-note pricing-cta-note mb-0">
                * No credit card required
              </p>
            </article>

          <article class="pricing-card pricing-card-featured">
              <div class="pricing-card-top">
                <span class="pricing-label">Pro Monthly</span>
                <h2>Try Pro</h2>
                <p class="pricing-price">$3.99 <span>/ month</span></p>
                <p class="pricing-note">7-day trial, then monthly billing</p>
              </div>
              <ul class="pricing-list">
                <li>Stronger Shield capacity</li>
                <li>Manual Block when you need direct protection</li>
                <li>Planned Sessions and reminders</li>
                <li>Focus reminders</li>
                <li>Recovery nudges when focus slips</li>
                <li>Pro restore support</li>
              </ul>
              <a href="download.html" class="btn btn-glow pricing-cta"
                >Start Focus Upgrade</a
              >
              <p class="pricing-note pricing-cta-note mb-0">
                * 7-day free trial through Google Play
              </p>
            </article>

          <article class="pricing-card pricing-card-yearly">
              <div class="pricing-card-top">
                <span class="pricing-label">Pro Yearly</span>
                <h2>Best Value</h2>
                <p class="pricing-price">$2.67 <span>/ month</span></p>
                <p class="pricing-micro">Best value for long-term focus</p>
                <p class="pricing-note">
                  Billed yearly at $31.99. About $2.67/month
                </p>
              </div>
              <ul class="pricing-list">
                <li>Stronger Shield capacity</li>
                <li>Manual Block when you need direct protection</li>
                <li>Planned Sessions and reminders</li>
                <li>Focus reminders</li>
                <li>Recovery nudges when focus slips</li>
                <li>Pro restore support</li>
                <li>Lower yearly price</li>
              </ul>
              <a
                href="download.html"
                class="btn btn-glow pricing-cta pricing-cta-yearly"
                >Lock in yearly — Save 33%</a
              >
              <p class="pricing-note pricing-cta-note mb-0">
                * Billed yearly at $31.99
              </p>
            </article>
        </div>
      </section>

      <section class="container py-5">
        <div class="faq-panel mx-auto">
          <div class="text-center faq-heading mx-auto">
            <span class="feature-kicker">
              Pro Details <span aria-hidden="true">&#128737;</span>
            </span>
            <h2 class="mb-3">What Pro is for</h2>
            <p class="hero-muted-override mb-0">
              Pro is for users who want CogniFocus to protect the habit, not
              just time a session
            </p>
          </div>

          <div class="faq-list">
            <div class="faq-item">
              <h3>Stronger protection</h3>
              <p class="mb-0">
                More Shield capacity, Manual Block, and stronger distraction
                control
              </p>
            </div>

            <div class="faq-item">
              <h3>Planned accountability</h3>
              <p class="mb-0">
                Planned Sessions and reminders help you show up before focus
                slips
              </p>
            </div>

            <div class="faq-item">
              <h3>Recovery support</h3>
              <p class="mb-0">
                Recovery nudges help bring users back after missed sessions or
                drift
              </p>
            </div>
          </div>
        </div>
      </section>

    </main>

    <section id="faq" class="py-5 cf-faq-fullbleed">
      <div class="cf-faq-accordion">
        <div class="cf-faq-list">
          <details class="cf-faq-item">
            <summary>
              How much is Pro Monthly?
              <span class="cf-faq-toggle" aria-hidden="true">+</span>
            </summary>
            <div class="cf-faq-body">
              <div class="cf-faq-content">
                $3.99/month after a 7-day trial
              </div>
            </div>
          </details>

          <details class="cf-faq-item">
            <summary>
              How much is Pro Yearly?
              <span class="cf-faq-toggle" aria-hidden="true">+</span>
            </summary>
            <div class="cf-faq-body">
              <div class="cf-faq-content">
                $31.99/year. About $2.67/month
              </div>
            </div>
          </details>

          <details class="cf-faq-item">
            <summary>
              Where do I manage billing?
              <span class="cf-faq-toggle" aria-hidden="true">+</span>
            </summary>
            <div class="cf-faq-body">
              <div class="cf-faq-content">
                Subscriptions are managed through Google Play
              </div>
            </div>
          </details>
        </div>
      </div>
    </section>
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeAttentionSpirals from "../components/home/HomeAttentionSpirals.astro";
import HomeFAQ from "../components/home/HomeFAQ.astro";
import HomeFinalCTA from "../components/home/HomeFinalCTA.astro";
import HomeGoblinCards from "../components/home/HomeGoblinCards.astro";
import HomeHero from "../components/home/HomeHero.astro";
import HomeTestimonials from "../components/home/HomeTestimonials.astro";

const title = "CogniFocus | Focus Timer & App Blocker for Android";
const description = "CogniFocus is a focus timer and app blocker for Android with Goblin reactions, Shield blocking, recovery nudges, and an iOS waitlist for iPhone updates.";
const canonical = "https://cognifocus.app/";
const ogTitle = "CogniFocus \u007c Focus Timer & App Blocker for Android";
const ogDescription = description;
const ogImageAlt = "CogniFocus landing page for a focus app that blocks distracting apps and reacts instantly";
const schemas = [
  JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "CogniFocus",
    "alternateName": "CogniFocus Focus Timer",
    "operatingSystem": "Android",
    "applicationCategory": "ProductivityApplication",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "description": "A focus timer and app blocker for Android with Goblin reactions, Shield blocking, recovery nudges, and an iOS waitlist for iPhone updates.",
    "url": "https://cognifocus.app",
    "downloadUrl": "https://play.google.com/store/apps/details?id=io.ionic.cognifocus",
    "featureList": [
      "Focus timer",
      "Distraction Shield app blocking",
      "Goblin companion reactions",
      "Recovery nudges",
      "Streaks and XP",
      "Planned sessions",
      "iOS waitlist"
    ]
  }),
  JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "CogniFocus",
    "url": "https://cognifocus.app/"
  }),
  JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "CogniFocus - Focus Timer & App Blocker for Android",
    "description": "CogniFocus is available now on Android, with an iOS waitlist open for iPhone updates.",
    "url": "https://cognifocus.app/",
    "relatedLink": "https://cognifocus.app/ios-waitlist.html"
  }),
  JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "CogniElevate",
    "url": "https://cognifocus.app/",
    "logo": "https://cognifocus.app/assets/logo/app-logo.png",
    "sameAs": [
      "https://www.tiktok.com/@cognifocus.app",
      "https://www.instagram.com/cognifocus.app/",
      "https://www.facebook.com/share/1Am7kCzkjG/",
      "https://x.com/getcognifocus",
      "https://www.pinterest.com/getcognifocus/",
      "https://www.producthunt.com/products/cognifocus"
    ]
  })
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  ogImageAlt={ogImageAlt}
  bodyClass="cf-home"
  launchBannerProps={{ includeIosNotification: false }}
  footerProps={{ includePinterest: true, faqHref: "/#faq", xHref: "https://x.com/getcognifocus" }}
>
  <meta slot="head-after-robots" name="author" content="CogniFocus" />
  <meta slot="head-after-robots" name="application-name" content="CogniFocus" />

  <link slot="head-after-icon" rel="preconnect" href="https://fonts.googleapis.com" />
  <link slot="head-after-icon" rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    slot="head-after-icon"
    rel="preload"
    as="style"
    href="https://fonts.googleapis.com/css2?family=Funnel+Display:wght@400..800&family=Funnel+Sans:wght@300..800&display=swap"
  />
  <link
    slot="head-after-icon"
    href="https://fonts.googleapis.com/css2?family=Funnel+Display:wght@400..800&family=Funnel+Sans:wght@300..800&display=swap"
    rel="stylesheet"
  />
  <meta slot="head-after-social" name="p:domain_verify" content="478f5d8e8349b9766bd792c88fe9ae49" />
  {schemas.map((schema) => <script slot="head-after-social" type="application/ld+json" set:html={schema}></script>)}

  <main id="main-content">
    <HomeHero />
    <HomeTestimonials />
    <HomeGoblinCards />
    <HomeAttentionSpirals />
    <HomeFinalCTA />
  </main>
  <HomeFAQ />
  <script>
    import "../scripts/entries/home.js";
  </script>
</BaseLayout>


---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeAttentionSpirals from "../components/home/HomeAttentionSpirals.astro";
import HomeFAQ from "../components/home/HomeFAQ.astro";
import HomeFinalCTA from "../components/home/HomeFinalCTA.astro";
import HomeGoblinCards from "../components/home/HomeGoblinCards.astro";
import HomeHero from "../components/home/HomeHero.astro";
import HomeDemoSection from "../components/home/HomeDemoSection.astro";
import HomeTestimonials from "../components/home/HomeTestimonials.astro";

const title = "CogniFocus — Focus Timer & App Blocker That Fights Back";
const description = "CogniFocus is a focus timer and app blocker with a Goblin companion that reacts when you drift to TikTok, Instagram, YouTube, and other distractions.";
const canonical = "https://cognifocus.app/";
const ogTitle = title;
const ogDescription = description;
const ogImage = "https://cognifocus.app/assets/og/og-image.png";
const twitterImage = "https://cognifocus.app/assets/og/og-twitter.png";
const ogImageWidth = 1200;
const ogImageHeight = 630;
const ogImageAlt = "CogniFocus reactive focus app with a Goblin companion that blocks distractions";
const videoSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": "How CogniFocus Helps You Stay Focused",
  "description":
    "Watch how CogniFocus helps protect focus with a focus timer, Distraction Shield, Goblin companion reactions, and distraction recovery.",
  "thumbnailUrl": "https://cognifocus.app/images/cognifocus-focus-app-demo-poster.webp",
  "uploadDate": "2026-05-24T00:00:00Z",
  "contentUrl": "https://cognifocus.app/videos/cognifocus-focus-app-demo.mp4",
  "embedUrl": "https://cognifocus.app/demo"
});
const schemas = [
  JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "CogniFocus",
    "alternateName": "CogniFocus Focus Timer",
    "operatingSystem": "Android",
    "applicationCategory": "ProductivityApplication",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "description": "A focus timer and app blocker for Android with Goblin reactions, Shield blocking, recovery nudges, and an iOS waitlist for iPhone updates.",
    "url": "https://cognifocus.app",
    "downloadUrl": "https://play.google.com/store/apps/details?id=io.ionic.cognifocus",
    "featureList": [
      "Focus timer",
      "Shield app blocking (reactive during sessions)",
      "Manual Block mode (proactive blocking)",
      "Focus DND mode (silent distraction-free focus)",
      "Goblin companion reactions",
      "Recovery nudges",
      "Streaks and XP",
      "Planned sessions",
      "iOS waitlist"
    ],
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "5",
      "bestRating": "5",
      "worstRating": "1",
      "ratingCount": "6"
    }
  }),
  JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "CogniFocus",
    "url": "https://cognifocus.app/",
    "potentialAction": {
      "@type": "DownloadAction",
      "target": "https://play.google.com/store/apps/details?id=io.ionic.cognifocus"
    }
  }),
  JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "CogniFocus - Focus Timer & App Blocker That Fights Back",
    "description": "CogniFocus is a focus timer and app blocker with a Goblin companion that reacts when you drift to TikTok, Instagram, YouTube, and other distractions.",
    "url": "https://cognifocus.app/",
    "relatedLink": "https://cognifocus.app/ios-waitlist.html"
  }),
  JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "CogniElevate",
    "url": "https://cognifocus.app/",
    "logo": "https://cognifocus.app/assets/logo/app-logo.png",
    "sameAs": [
      "https://www.tiktok.com/@cognifocus.app",
      "https://www.instagram.com/cognifocus.app/",
      "https://www.facebook.com/share/1Am7kCzkjG/",
      "https://x.com/iqasim_explores",
      "https://www.pinterest.com/getcognifocus/",
      "https://www.producthunt.com/products/cognifocus"
    ]
  }),
  JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Review",
    "itemReviewed": { "@type": "SoftwareApplication", "name": "CogniFocus" },
    "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" },
    "author": { "@type": "Person", "name": "Beta Tester" },
    "reviewBody": "The neutral look is almost worse than a notification. It feels like the app noticed I was about to drift before I did."
  }),
  JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Review",
    "itemReviewed": { "@type": "SoftwareApplication", "name": "CogniFocus" },
    "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" },
    "author": { "@type": "Person", "name": "Study Session User" },
    "reviewBody": "I opened TikTok out of habit and the annoyed Goblin snapped me out of autopilot faster than any timer I have used."
  }),
  JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Review",
    "itemReviewed": { "@type": "SoftwareApplication", "name": "CogniFocus" },
    "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" },
    "author": { "@type": "Person", "name": "Early Access User" },
    "reviewBody": "Went from 8 Instagram breaks per study session to maybe 1. The Goblin celebrating the clean session made me want to keep the streak alive."
  }),
  JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Review",
    "itemReviewed": { "@type": "SoftwareApplication", "name": "CogniFocus" },
    "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" },
    "author": { "@type": "Person", "name": "Focus Sprint User" },
    "reviewBody": "The angry reaction is ridiculous in the best way. It turns one more scroll into a tiny moment of accountability."
  })
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  ogImage={ogImage}
  twitterImage={twitterImage}
  ogImageWidth={ogImageWidth}
  ogImageHeight={ogImageHeight}
  ogImageAlt={ogImageAlt}
  bodyClass="cf-home"
  launchBannerProps={{ includeIosNotification: false }}
  rssHref="/feed.xml"
  footerProps={{ includePinterest: true, faqHref: "/#faq", xHref: "https://x.com/iqasim_explores" }}
>
  <meta slot="head-after-robots" name="author" content="CogniFocus" />
  <meta slot="head-after-robots" name="application-name" content="CogniFocus" />
  <script slot="head-after-social" type="application/ld+json" set:html={videoSchema} />

  <link slot="head-after-icon" rel="preconnect" href="https://fonts.googleapis.com" />
  <link slot="head-after-icon" rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    slot="head-after-icon"
    href="https://fonts.googleapis.com/css2?family=Funnel+Display:wght@400..800&family=Funnel+Sans:wght@300..800&display=swap"
    rel="stylesheet"
    media="print"
    onload="this.media='all'"
  />
  <noscript slot="head-after-icon"><link href="https://fonts.googleapis.com/css2?family=Funnel+Display:wght@400..800&family=Funnel+Sans:wght@300..800&display=swap" rel="stylesheet" /></noscript>
  {schemas.map((schema) => <script slot="head-after-social" type="application/ld+json" set:html={schema}></script>)}

  <main id="main-content">
    <HomeHero />
    <HomeDemoSection />
    <HomeTestimonials />
    <HomeGoblinCards />
    <HomeAttentionSpirals />
    <HomeFinalCTA />
  </main>
  <HomeFAQ />
  <script>
    import "../scripts/entries/home.js";
  </script>
</BaseLayout>

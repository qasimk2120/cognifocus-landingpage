---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  formatReleaseDate,
  getReleaseBySlug,
  getReleaseDetailSections,
  getSortedReleases,
} from "../../utils/releases.js";

export async function getStaticPaths() {
  const releases = await getSortedReleases();
  return releases.map((release, index) => ({
    params: { slug: release.slug },
    props: {
      release,
      prevRelease: releases[index + 1] ?? null,
      nextRelease: releases[index - 1] ?? null,
    },
  }));
}

const { slug } = Astro.params;
const release = Astro.props.release || (await getReleaseBySlug(slug));
const { prevRelease, nextRelease } = Astro.props;

if (!release) {
  throw new Error(`Missing published release note content for ${slug}`);
}

const title = `${release.title} | CogniFocus What's New`;
const description = release.summary;
const canonical = release.canonical || `https://cognifocus.app/whats-new/${release.slug}.html`;
const sections = getReleaseDetailSections(release);
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogTitle={title}
  ogDescription={description}
  ogImageAlt="CogniFocus app logo for a distraction-aware focus timer with character reactions"
  bodyClass="whats-new-page cf-shell"
  assetBase="../assets"
  footerProps={{}}
>
  <script slot="head-after-social" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    headline: release.title,
    description: release.summary,
    datePublished: release.publishedAt,
    dateModified: release.updatedAt || release.publishedAt,
    image: "https://cognifocus.app/assets/og/og-image.png",
    url: canonical,
    author: {
      "@type": "Person",
      name: "Qasim Khan",
      url: "https://cognifocus.app/about.html",
      jobTitle: "Founder, CogniFocus",
    },
    publisher: {
      "@type": "Organization",
      name: "CogniFocus",
      url: "https://cognifocus.app",
      logo: {
        "@type": "ImageObject",
        url: "https://cognifocus.app/assets/logo/app-logo.png",
      },
    },
  })}></script>
  <script slot="head-after-social" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://cognifocus.app/" },
      { "@type": "ListItem", position: 2, name: "What's New", item: "https://cognifocus.app/whats-new.html" },
      { "@type": "ListItem", position: 3, name: release.title, item: canonical },
    ],
  })}></script>
  <link slot="head-after-social" rel="preconnect" href="https://fonts.googleapis.com" />
  <link slot="head-after-social" rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link slot="head-after-social" rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Funnel+Display:wght@400..800&family=Funnel+Sans:wght@300..800&display=swap" />
  <link slot="head-after-social" href="https://fonts.googleapis.com/css2?family=Funnel+Display:wght@400..800&family=Funnel+Sans:wght@300..800&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
  <noscript slot="head-after-social"><link href="https://fonts.googleapis.com/css2?family=Funnel+Display:wght@400..800&family=Funnel+Sans:wght@300..800&display=swap" rel="stylesheet" /></noscript>
  <main class="container py-5 seo-guide-main">
    <article class="focus-loop-panel mx-auto p-4 p-md-5 seo-guide-panel blog-panel blog-content">
      <nav class="blog-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a> &gt; <a href="/whats-new.html">What's New</a> &gt;
        <span>{release.title}</span>
      </nav>

      <span class="feature-kicker">{release.category}</span>
      <h1 class="hero-heading mt-3">{release.title}</h1>
      {release.publishedAt && <p class="blog-meta mb-3">Published {formatReleaseDate(release.publishedAt)}</p>}
      <p class="hero-muted-override">{release.summary}</p>

      {release.bodyHtml ? (
        <Fragment set:html={release.bodyHtml} />
      ) : (
        sections.map(([label, items]) => (
          <section class="release-note-section">
            <h2>{label}</h2>
            <ul>
              {items.map((item) => <li>{item}</li>)}
            </ul>
          </section>
        ))
      )}
      {(prevRelease || nextRelease) && (
        <nav class="blog-post-nav" aria-label="Release navigation" style="display:flex;justify-content:space-between;gap:1rem;margin-top:2rem;padding-top:1.5rem;border-top:1px solid var(--border-subtle,#e5e7eb)">
          {prevRelease ? (
            <a href={prevRelease.canonical || `/whats-new/${prevRelease.slug}.html`} rel="prev" style="flex:1;text-align:left">
              &larr; {prevRelease.title}
            </a>
          ) : <span style="flex:1" />}
          {nextRelease ? (
            <a href={nextRelease.canonical || `/whats-new/${nextRelease.slug}.html`} rel="next" style="flex:1;text-align:right">
              {nextRelease.title} &rarr;
            </a>
          ) : <span style="flex:1" />}
        </nav>
      )}
    </article>
  </main>
</BaseLayout>

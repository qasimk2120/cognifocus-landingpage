---
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout
  title="CogniFocus CMS Login"
  description="Private CogniFocus CMS login."
  showNav={false}
>
  <script
    src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"
    async
    defer
  ></script>

  <main class="admin-login-shell">
    <section class="admin-login-card">
      <div class="admin-login-brand">
        <img src="/assets/logo/app-logo.png" alt="" width="40" height="40" />
        <span>CogniFocus CMS</span>
      </div>
      <div>
        <p class="admin-kicker">Private admin</p>
        <h1>Sign in</h1>
        <p>Use the authorized CogniFocus Google account.</p>
      </div>

      <div
        class="admin-turnstile"
        data-admin-turnstile
        aria-label="Security check"
      ></div>

      <form class="admin-form" data-admin-login-form>
        <div class="admin-honeypot" aria-hidden="true">
          <label for="adminLoginWebsite">Website</label>
          <input
            id="adminLoginWebsite"
            type="text"
            name="website"
            tabindex="-1"
            autocomplete="off"
          />
          <label for="adminLoginCompany">Company</label>
          <input
            id="adminLoginCompany"
            type="text"
            name="company"
            tabindex="-1"
            autocomplete="off"
          />
          <label for="adminLoginUrl">URL</label>
          <input
            id="adminLoginUrl"
            type="text"
            name="url"
            tabindex="-1"
            autocomplete="off"
          />
        </div>
        <button
          type="submit"
          class="admin-button admin-button-primary"
          data-admin-login-submit
          disabled
        >
          Sign in with Google
        </button>
        <p class="admin-form-message" data-admin-login-message role="status"></p>
      </form>
    </section>
  </main>

  <script>
    import "../../scripts/admin/login.js";
  </script>
</AdminLayout>

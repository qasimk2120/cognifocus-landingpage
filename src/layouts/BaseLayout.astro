---
import LaunchBanner from "../components/layout/LaunchBanner.astro";
import Header from "../components/layout/Header.astro";
import FeaturedStrip from "../components/layout/FeaturedStrip.astro";
import Footer from "../components/layout/Footer.astro";
import GoblinAmbient from "../components/layout/GoblinAmbient.astro";
import GoblinBot from "../components/layout/GoblinBot.astro";
import CookieConsent from "../components/analytics/CookieConsent.astro";
import NewsletterStrip from "../components/newsletter/NewsletterStrip.astro";
import NewsletterDialog from "../components/newsletter/NewsletterDialog.astro";
import siteStylesheet from "../styles/site.css?url";
import PostHog from "../components/analytics/PostHog.astro";

const {
  charset = "UTF-8",
  title,
  description,
  canonical,
  ogType = "website",
  ogTitle = title,
  ogDescription = description,
  ogImage = "https://cognifocus.app/assets/og/og-image.png",
  twitterImage = ogImage,
  ogImageWidth = 1200,
  ogImageHeight = 630,
  ogImageAlt = "CogniFocus",
  includeOgImageAlt = true,
  includeOgSiteName = true,
  twitterAttribute = "name",
  includeTwitterImageAlt = true,
  robots = "index, follow",
  bodyClass = "cf-shell",
  bodyAttributes = {},
  baseStylesheet = siteStylesheet,
  stylesheetsBeforeBase = [],
  stylesheets = [],
  footerProps = {},
  featuredStripProps = {},
  launchBannerProps = {},
  headerProps = {},
  showFeaturedStrip = true,
  showNewsletterStrip = false,
  assetBase = "assets",
  rssHref,
  rssTitle = "CogniFocus Blog RSS",
} = Astro.props;

const twitterAttr = twitterAttribute === "property" ? "property" : "name";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset={charset} />
    <!-- Google Tag Manager -->
    <script is:inline>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-MS5PKVDV');
    </script>
    <!-- End Google Tag Manager -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="robots" content={robots} />
    <meta name="p:domain_verify" content="478f5d8e8349b9766bd792c88fe9ae49" />
    <meta name="ft-site-verification" content="ft-463044d1f499409cbe93ff7c171b1399" />
    <slot name="head-after-robots" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={`/${assetBase}/logo/app-logo.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`/${assetBase}/logo/app-logo.png`} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="color-scheme" content="dark light" />
    <script is:inline>
      const THEME_STORAGE_KEY = "cognifocus-theme";
      const root = document.documentElement;

      const readStoredTheme = () => {
        try {
          const storedTheme = localStorage.getItem(THEME_STORAGE_KEY);
          return storedTheme === "light" || storedTheme === "dark" ? storedTheme : null;
        } catch {
          return null;
        }
      };

      const getSystemTheme = () =>
        window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light";

      const theme = readStoredTheme() ?? getSystemTheme();
      root.dataset.theme = theme;
      root.style.colorScheme = theme;
    </script>
    <slot name="head-after-icon" />

    <meta property="og:type" content={ogType} />
    {includeOgSiteName && <meta property="og:site_name" content="CogniFocus" />}
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={ogImageWidth} />
    <meta property="og:image:height" content={ogImageHeight} />
    {includeOgImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}

    <meta {...{ [twitterAttr]: "twitter:card" }} content="summary_large_image" />
    <meta {...{ [twitterAttr]: "twitter:url" }} content={canonical} />
    <meta {...{ [twitterAttr]: "twitter:title" }} content={ogTitle} />
    <meta {...{ [twitterAttr]: "twitter:description" }} content={ogDescription} />
    <meta {...{ [twitterAttr]: "twitter:image" }} content={twitterImage} />
    {includeTwitterImageAlt && <meta {...{ [twitterAttr]: "twitter:image:alt" }} content={ogImageAlt} />}
    {
      rssHref && (
        <link
          rel="alternate"
          type="application/rss+xml"
          title={rssTitle}
          href={rssHref}
        />
      )
    }
    <slot name="head-after-social" />

    <slot name="head-before-base-styles" />
    {
      stylesheetsBeforeBase.map((href) => (
        <>
          <link rel="preload" as="style" href={href} />
          <link rel="stylesheet" href={href} media="print" onload="this.media='all'" />
          <noscript><link rel="stylesheet" href={href} /></noscript>
        </>
      ))
    }
    <link rel="preload" as="style" href={baseStylesheet} />
    <link rel="stylesheet" href={baseStylesheet} media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href={baseStylesheet} /></noscript>
    {
      stylesheets.map((href) => (
        <>
          <link rel="preload" as="style" href={href} />
          <link rel="stylesheet" href={href} media="print" onload="this.media='all'" />
          <noscript><link rel="stylesheet" href={href} /></noscript>
        </>
      ))
    }
    <script>
      import "../scripts/entries/shared.js";
    </script>
    <script src="https://analytics.ahrefs.com/analytics.js" data-key="nA1wJyb7Q7r3Ofb98mlDlg" async></script>
    <slot name="head" />
    <PostHog />
  </head>
  <body class={bodyClass} {...bodyAttributes}>
    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-MS5PKVDV"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
      ></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->
    <GoblinAmbient />
    <LaunchBanner {...launchBannerProps} />
    <Header assetBase={assetBase} {...headerProps} />
    <slot />
    {showFeaturedStrip && <FeaturedStrip {...featuredStripProps} />}
    {showNewsletterStrip && <NewsletterStrip />}
    <Footer {...footerProps} assetBase={assetBase} />
    <NewsletterDialog />
    <CookieConsent />
    <GoblinBot />
    <script>
      // Dynamic import deferred to load + idle — breaks the newsletter → form →
      // waitlist-response.js chain off the 417ms critical network path.
      // Dialog auto-triggers at 45s, strip is below the fold — safe to defer.
      const loadNewsletter = () => import("../scripts/entries/newsletter.js");
      const afterIdle = (fn: () => void) => {
        if ("requestIdleCallback" in window) {
          (window as any).requestIdleCallback(fn, { timeout: 4000 });
        } else {
          setTimeout(fn, 1000);
        }
      };
      if (document.readyState === "complete") {
        afterIdle(loadNewsletter);
      } else {
        window.addEventListener("load", () => afterIdle(loadNewsletter), { once: true });
      }
    </script>
  </body>
</html>

---
import LaunchBanner from "../components/layout/LaunchBanner.astro";
import Header from "../components/layout/Header.astro";
import FeaturedStrip from "../components/layout/FeaturedStrip.astro";
import Footer from "../components/layout/Footer.astro";

const {
  charset = "UTF-8",
  title,
  description,
  canonical,
  ogType = "website",
  ogTitle = title,
  ogDescription = description,
  ogImage = "https://cognifocus.app/assets/og/og-image.png",
  ogImageAlt = "CogniFocus",
  includeOgImageAlt = true,
  includeOgSiteName = true,
  twitterAttribute = "name",
  includeTwitterImageAlt = true,
  bodyClass = "cf-shell",
  bodyAttributes = {},
  baseStylesheet = "style.css",
  includeDefaultBootstrapIcons = true,
  stylesheetsBeforeBase = [],
  stylesheets = [],
  sharedScriptSrc = "shared.js?v=20260515-1",
  bootstrapIconsFirst = false,
  footerProps = {},
  featuredStripProps = {},
  launchBannerProps = {},
  headerProps = {},
  showFeaturedStrip = true,
  assetBase = "assets",
  rssHref,
  rssTitle = "CogniFocus Blog RSS",
} = Astro.props;

const twitterAttr = twitterAttribute === "property" ? "property" : "name";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset={charset} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <slot name="head-after-robots" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={`${assetBase}/logo/app-logo.png`} />
    <slot name="head-after-icon" />
    {
      includeDefaultBootstrapIcons && bootstrapIconsFirst && (
        <link
          rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css"
        />
      )
    }

    <meta property="og:type" content={ogType} />
    {includeOgSiteName && <meta property="og:site_name" content="CogniFocus" />}
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={ogImage} />
    {includeOgImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}

    <meta {...{ [twitterAttr]: "twitter:card" }} content="summary_large_image" />
    <meta {...{ [twitterAttr]: "twitter:url" }} content={canonical} />
    <meta {...{ [twitterAttr]: "twitter:title" }} content={ogTitle} />
    <meta {...{ [twitterAttr]: "twitter:description" }} content={ogDescription} />
    <meta {...{ [twitterAttr]: "twitter:image" }} content={ogImage} />
    {includeTwitterImageAlt && <meta {...{ [twitterAttr]: "twitter:image:alt" }} content={ogImageAlt} />}
    {
      rssHref && (
        <link
          rel="alternate"
          type="application/rss+xml"
          title={rssTitle}
          href={rssHref}
        />
      )
    }
    <slot name="head-after-social" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <slot name="head-before-base-styles" />
    {stylesheetsBeforeBase.map((href) => <link rel="stylesheet" href={href} />)}
    <link rel="stylesheet" href={baseStylesheet} />
    {stylesheets.map((href) => <link rel="stylesheet" href={href} />)}
    {
      includeDefaultBootstrapIcons && !bootstrapIconsFirst && (
        <link
          rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css"
        />
      )
    }
    <script src={sharedScriptSrc} defer is:inline></script>
    <slot name="head" />
  </head>
  <body class={bodyClass} {...bodyAttributes}>
    <LaunchBanner {...launchBannerProps} />
    <Header assetBase={assetBase} {...headerProps} />
    <slot />
    {showFeaturedStrip && <FeaturedStrip {...featuredStripProps} />}
    <Footer {...footerProps} assetBase={assetBase} />
  </body>
</html>

---
import LaunchBanner from "../components/layout/LaunchBanner.astro";
import Header from "../components/layout/Header.astro";
import FeaturedStrip from "../components/layout/FeaturedStrip.astro";
import Footer from "../components/layout/Footer.astro";
import CookieConsent from "../components/analytics/CookieConsent.astro";
import siteStylesheet from "../styles/site.css?url";
import PostHog from "../components/analytics/PostHog.astro";

const csp = [
  "default-src 'self'",
  "base-uri 'self'",
  "object-src 'none'",
  "form-action 'self'",
  "script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://eu-assets.i.posthog.com https://eu.i.posthog.com",
  "style-src 'self' 'unsafe-inline' https://fonts.googleapis.com",
  "img-src 'self' data: https://cognifocus.app https://startupfa.st https://www.startupfa.st https://dayslaunch.com https://www.producthunt.com https://api.producthunt.com https://peerpush.net https://startupbenchmarks.com https://cdn.prod.website-files.com https://nicklaunches.com",
  "font-src 'self' https://fonts.gstatic.com",
  "connect-src 'self' https://europe-west1-cognifocuslandingpage.cloudfunctions.net https://eu.i.posthog.com https://eu-assets.i.posthog.com",
  "frame-src https://challenges.cloudflare.com",
  "worker-src 'self' blob:",
  "upgrade-insecure-requests",
].join("; ");

const {
  charset = "UTF-8",
  title,
  description,
  canonical,
  ogType = "website",
  ogTitle = title,
  ogDescription = description,
  ogImage = "https://cognifocus.app/assets/og/og-image.png",
  ogImageAlt = "CogniFocus",
  includeOgImageAlt = true,
  includeOgSiteName = true,
  twitterAttribute = "name",
  includeTwitterImageAlt = true,
  bodyClass = "cf-shell",
  bodyAttributes = {},
  baseStylesheet = siteStylesheet,
  stylesheetsBeforeBase = [],
  stylesheets = [],
  footerProps = {},
  featuredStripProps = {},
  launchBannerProps = {},
  headerProps = {},
  showFeaturedStrip = true,
  assetBase = "assets",
  rssHref,
  rssTitle = "CogniFocus Blog RSS",
} = Astro.props;

const twitterAttr = twitterAttribute === "property" ? "property" : "name";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset={charset} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="robots" content="index, follow" />
    <slot name="head-after-robots" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={`${assetBase}/logo/app-logo.png`} />
    <link rel="apple-touch-icon" href={`${assetBase}/logo/app-logo.png`} />
    <meta name="color-scheme" content="dark light" />
    <script is:inline>
      const THEME_STORAGE_KEY = "cognifocus-theme";
      const root = document.documentElement;

      const readStoredTheme = () => {
        try {
          const storedTheme = localStorage.getItem(THEME_STORAGE_KEY);
          return storedTheme === "light" || storedTheme === "dark" ? storedTheme : null;
        } catch {
          return null;
        }
      };

      const getSystemTheme = () =>
        window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light";

      const theme = readStoredTheme() ?? getSystemTheme();
      root.dataset.theme = theme;
      root.style.colorScheme = theme;
    </script>
    <slot name="head-after-icon" />

    <meta property="og:type" content={ogType} />
    {includeOgSiteName && <meta property="og:site_name" content="CogniFocus" />}
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={ogImage} />
    {includeOgImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}

    <meta {...{ [twitterAttr]: "twitter:card" }} content="summary_large_image" />
    <meta {...{ [twitterAttr]: "twitter:url" }} content={canonical} />
    <meta {...{ [twitterAttr]: "twitter:title" }} content={ogTitle} />
    <meta {...{ [twitterAttr]: "twitter:description" }} content={ogDescription} />
    <meta {...{ [twitterAttr]: "twitter:image" }} content={ogImage} />
    {includeTwitterImageAlt && <meta {...{ [twitterAttr]: "twitter:image:alt" }} content={ogImageAlt} />}
    {
      rssHref && (
        <link
          rel="alternate"
          type="application/rss+xml"
          title={rssTitle}
          href={rssHref}
        />
      )
    }
    <slot name="head-after-social" />

    <slot name="head-before-base-styles" />
    {stylesheetsBeforeBase.map((href) => <link rel="stylesheet" href={href} />)}
    <link rel="stylesheet" href={baseStylesheet} />
    {stylesheets.map((href) => <link rel="stylesheet" href={href} />)}
    <script>
      import "../scripts/entries/shared.js";
    </script>
    <slot name="head" />
    <PostHog />
  </head>
  <body class={bodyClass} {...bodyAttributes}>
    <LaunchBanner {...launchBannerProps} />
    <Header assetBase={assetBase} {...headerProps} />
    <slot />
    {showFeaturedStrip && <FeaturedStrip {...featuredStripProps} />}
    <Footer {...footerProps} assetBase={assetBase} />
    <CookieConsent />
  </body>
</html>
